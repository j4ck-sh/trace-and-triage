---
import { getCollection } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";

import InvestigationCard from "../components/InvestigationCard.astro";
import ResearchExplorer from "../components/ResearchExplorer.astro";
import RevealOnScroll from "../components/RevealOnScroll.astro";

// Existing reading-time utilities
import {
  getReadingTime,
  formatReadingTime
} from "../utils/readingTime";

// GitHub Pages base path
const base = import.meta.env.BASE_URL;

// Load published research only
const articles = await getCollection(
  "research",
  ({ data }) => !data.draft
);

// Sort newest first
const sortedArticles = [...articles].sort(
  (a, b) =>
    b.data.date.getTime() - a.data.date.getTime()
);

// Generate available categories
const categories = [
  ...new Set(
    sortedArticles.map(
      (article) => article.data.category
    )
  )
].sort();

// Research statistics
const totalInvestigations = sortedArticles.length;
const totalCategories = categories.length;
---

<BaseLayout
  title="Research | Trace & Triage"
  description="Explore independent digital forensics, incident response, malware analysis and specialist cybersecurity investigations."
>

  <div class="research-page">

    <!-- =====================================
         RESEARCH HEADER
         ===================================== -->

    <header class="research-header" data-reveal>

      <div class="research-header-top">
        <span class="research-eyebrow">
          TT / INVESTIGATION ARCHIVE
        </span>

        <span class="research-workspace">
          WORKSPACE 02
        </span>
      </div>

      <div class="research-header-content">

        <div>
          <h1>
            Explore the
            <em>evidence.</em>
          </h1>

          <p class="research-intro">
            Browse evidence-led investigations,
            technical research and documented
            forensic analysis across digital systems,
            malware and specialist technologies.
          </p>
        </div>

        <aside
          class="research-index-status"
          aria-label="Research archive statistics"
        >
          <div class="status-heading">
            <span>~/research/index</span>
            <span class="status-indicator" aria-hidden="true"></span>
          </div>

          <div class="status-row">
            <span>INVESTIGATIONS</span>
            <strong>{totalInvestigations}</strong>
          </div>

          <div class="status-row">
            <span>CATEGORIES</span>
            <strong>{totalCategories}</strong>
          </div>

          <div class="status-row">
            <span>ARCHIVE</span>
            <strong>AVAILABLE</strong>
          </div>
        </aside>

      </div>

    </header>

    <!-- =====================================
         PAGEFIND FULL-TEXT SEARCH
         ===================================== -->

    <section
      class="research-search"
      aria-labelledby="research-search-title"
      data-reveal
    >

      <div class="section-top">
        <span class="section-index">01 / FULL-TEXT SEARCH</span>
        <span class="section-meta">RESEARCH DATABASE</span>
      </div>

      <h2 id="research-search-title">
        Search the Archive
      </h2>

      <p>
        Search the contents of published investigations,
        including technical findings, artefacts and
        documented research.
      </p>

      <div id="tt-pagefind-search"></div>

      <p class="search-note">
        Full-text search is available after the
        website has been built.
      </p>

    </section>

    <!-- =====================================
         INVESTIGATION EXPLORER
         ===================================== -->

    <section
      class="research-browser"
      aria-labelledby="research-browser-title"
    >

      <div class="section-top" data-reveal>
        <span class="section-index">02 / INVESTIGATION BROWSER</span>
        <span class="section-meta">
          {totalInvestigations} CASE FILES
        </span>
      </div>

      <h2 id="research-browser-title" class="browser-title" data-reveal>
        Investigation Index
      </h2>

      <ResearchExplorer categories={categories} />

      <!-- INVESTIGATION CARDS -->

      <div
        id="tt-investigation-grid"
        class="tt-investigation-grid"
      >

        {sortedArticles.map((article, index) => (
          <div
            class="investigation-item"
            data-investigation
            data-reveal
            data-title={article.data.title}
            data-category={article.data.category}
            data-date={article.data.date.toISOString()}
            data-search={[
              article.data.title,
              article.data.description,
              article.data.caseId,
              article.data.category,
              ...(article.data.tags ?? [])
            ].join(" ").toLowerCase()}
          >
            <InvestigationCard
              title={article.data.title}
              description={article.data.description}
              caseId={article.data.caseId}
              category={article.data.category}
              date={article.data.date}
              tags={article.data.tags ?? []}
              readingTime={formatReadingTime(
                getReadingTime(article)
              )}
              href={`${base}research/${article.id}/`}
              featured={index === 0}
            />
          </div>
        ))}

      </div>

      <!-- EMPTY RESULTS -->

      <p
        id="tt-empty-results"
        class="tt-empty-results"
        hidden
      >
        No investigations match your filters.
        Try another search or reset the filters.
      </p>

      <!-- NO PUBLISHED RESEARCH -->

      {sortedArticles.length === 0 && (
        <p class="no-research">
          No published investigations are currently available.
        </p>
      )}

    </section>

    <!-- =====================================
         RESEARCH METHODOLOGY
         ===================================== -->

    <section class="research-methodology" data-reveal>

      <div class="section-top">
        <span class="section-index">03 / RESEARCH STANDARDS</span>
        <span class="section-meta">METHODOLOGY</span>
      </div>

      <div class="methodology-content">

        <div>
          <h2>
            Research with
            <em>purpose.</em>
          </h2>

          <p>
            Trace & Triage focuses on structured
            investigations, transparent methodology,
            evidence handling and reproducible
            technical analysis.
          </p>

          <a href={`${base}methodology/`}>
            Explore Research Methodology
            <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="methodology-details">
          <span>01 / IDENTIFY</span>
          <span>02 / ACQUIRE</span>
          <span>03 / ANALYSE</span>
          <span>04 / DOCUMENT</span>
        </div>

      </div>

    </section>

    <!-- =====================================
         RESEARCH FOOTER
         ===================================== -->

    <div class="research-bottom">
      <span>TRACE & TRIAGE / RESEARCH</span>

      <a href={base}>
        ← Return to Homepage
      </a>
    </div>

  </div>

  <RevealOnScroll />

</BaseLayout>

<!-- ==========================================
     PAGEFIND INITIALISATION
     ========================================== -->

<script>
  async function initialisePagefind() {
    const container = document.getElementById(
      "tt-pagefind-search"
    );

    if (!container) return;
    if (container.dataset.ready === "true") return;

    const base = import.meta.env.BASE_URL;

    try {
      const pagefindModule = await import(
        /* @vite-ignore */
        `${base}pagefind/pagefind-ui.js`
      );

      // Pagefind UI is normally provided as a global
      // script in a static build, not as an ES module.
      // We handle the global below.
      void pagefindModule;
    } catch {
      // In development, Pagefind may not exist yet.
    }

    const PagefindUI = (
      window as Window & {
        PagefindUI?: new (options: {
          element: string;
          showSubResults?: boolean;
          showImages?: boolean;
        }) => unknown;
      }
    ).PagefindUI;

    if (PagefindUI) {
      new PagefindUI({
        element: "#tt-pagefind-search",
        showSubResults: true,
        showImages: false
      });

      container.dataset.ready = "true";
    } else {
      container.textContent =
        "Full-text search is available in the production build.";
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      initialisePagefind,
      { once: true }
    );
  } else {
    initialisePagefind();
  }

  document.addEventListener(
    "astro:page-load",
    initialisePagefind
  );
</script>

<style>
  /* ==========================================
     RESEARCH PAGE
     ========================================== */

  .research-page {
    width: min(100% - 40px, 1200px);
    margin: 0 auto;
    padding: 35px 0 90px;
  }

  /* HEADER */

  .research-header {
    padding: 25px 0 65px;
    border-top: 1px solid var(--tt-border);
    border-bottom: 1px solid var(--tt-border);
  }

  .research-header-top,
  .section-top,
  .research-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 15px;
    font-family: var(--tt-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.07em;
  }

  .research-eyebrow,
  .section-index {
    color: var(--tt-blue);
  }

  .research-workspace,
  .section-meta {
    color: var(--tt-muted);
  }

  .research-header-content {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(260px, 0.8fr);
    align-items: center;
    gap: 50px;
    margin-top: 55px;
  }

  .research-header h1 {
    margin: 0 0 25px;
    color: var(--tt-heading);
    font-family: var(--tt-font-editorial);
    font-size: clamp(3.2rem, 7vw, 6.5rem);
    font-weight: 400;
    line-height: 1.03;
    letter-spacing: -0.055em;
  }

  .research-header h1 em {
    display: block;
    color: var(--tt-blue);
    font-weight: 400;
  }

  .research-intro {
    max-width: 650px;
    color: var(--tt-muted);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  /* STATUS PANEL */

  .research-index-status {
    padding: 22px;
    background: var(--tt-deep);
    border: 1px solid var(--tt-border);
    border-radius: var(--tt-radius-md);
  }

  .status-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
    color: var(--tt-blue);
    font-family: var(--tt-font-mono);
    font-size: 0.75rem;
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tt-green);
  }

  .status-row {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 12px 0;
    border-bottom: 1px solid var(--tt-border);
    color: var(--tt-muted);
    font-family: var(--tt-font-mono);
    font-size: 0.75rem;
  }

  .status-row:last-child {
    border-bottom: none;
  }

  .status-row strong {
    color: var(--tt-heading);
  }

  /* SHARED SECTIONS */

  .research-search,
  .research-browser,
  .research-methodology {
    margin-top: 80px;
  }

  .research-search h2,
  .browser-title {
    margin: 18px 0;
    color: var(--tt-heading);
    font-family: var(--tt-font-editorial);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
  }

  .research-search > p,
  .search-note {
    color: var(--tt-muted);
    line-height: 1.7;
  }

  /* PAGEFIND */

  #tt-pagefind-search {
    margin-top: 25px;
    padding: 20px;
    background: var(--tt-surface);
    border: 1px solid var(--tt-border);
    border-radius: var(--tt-radius-md);
  }

  .search-note {
    margin-top: 15px;
    font-family: var(--tt-font-mono);
    font-size: 0.75rem;
  }

  /* INVESTIGATION GRID */

  .tt-investigation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: 35px 0;
  }

  .investigation-item {
    min-width: 0;
    display: flex;
  }

  .investigation-item :global(.investigation-card) {
    width: 100%;
  }

  .investigation-item:first-child {
    grid-column: 1 / -1;
  }

  .investigation-item[hidden] {
    display: none !important;
  }

  .tt-empty-results,
  .no-research {
    padding: 30px;
    background: var(--tt-surface);
    border: 1px solid var(--tt-border);
    border-radius: var(--tt-radius-md);
    color: var(--tt-muted);
    text-align: center;
  }

  /* METHODOLOGY */

  .research-methodology {
    padding: 30px;
    background: var(--tt-deep);
    border-left: 3px solid var(--tt-purple);
  }

  .methodology-content {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(200px, 0.7fr);
    gap: 35px;
    margin-top: 25px;
  }

  .methodology-content h2 {
    margin: 0 0 25px;
    font-family: var(--tt-font-editorial);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
    color: var(--tt-heading);
  }

  .methodology-content h2 em {
    display: block;
    color: var(--tt-purple);
  }

  .methodology-content p {
    max-width: 650px;
    color: var(--tt-muted);
    line-height: 1.8;
  }

  .methodology-content a {
    display: inline-flex;
    gap: 20px;
    margin-top: 15px;
    color: var(--tt-blue);
    font-family: var(--tt-font-mono);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .methodology-content a:hover {
    text-decoration: underline;
  }

  .methodology-details {
    display: flex;
    flex-direction: column;
    gap: 15px;
    justify-content: center;
  }

  .methodology-details span {
    padding: 12px 0;
    border-bottom: 1px solid var(--tt-border);
    color: var(--tt-purple);
    font-family: var(--tt-font-mono);
    font-size: 0.8rem;
  }

  /* FOOTER */

  .research-bottom {
    margin-top: 75px;
    padding-top: 20px;
    border-top: 1px solid var(--tt-border);
    color: var(--tt-muted);
  }

  .research-bottom a {
    color: var(--tt-blue);
    text-decoration: none;
  }

  /* RESPONSIVE */

  @media (max-width: 850px) {
    .research-header-content,
    .methodology-content {
      grid-template-columns: 1fr;
    }

    .tt-investigation-grid {
      grid-template-columns: 1fr;
    }

    .investigation-item:first-child {
      grid-column: auto;
    }
  }

  @media (max-width: 600px) {
    .research-page {
      width: min(100% - 30px, 1200px);
    }

    .research-header-content {
      margin-top: 35px;
    }

    .research-search,
    .research-browser,
    .research-methodology {
      margin-top: 55px;
    }

    .research-methodology {
      padding: 20px;
    }
  }
</style>