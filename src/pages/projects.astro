---
import { getCollection } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProjectExplorer from "../components/ProjectExplorer.astro";

const base = import.meta.env.BASE_URL;

const projects = await getCollection(
  "projects",
  ({ data }) => !data.draft
);

const sortedProjects = [...projects].sort(
  (a, b) => a.data.title.localeCompare(b.data.title)
);
---

<BaseLayout
  title="Projects | Trace & Triage"
  description="Explore independent digital forensics research projects and specialist technical laboratories."
>
  <div class="projects-page">

    <header class="projects-header">
      <div class="header-top">
        <span>TT / RESEARCH LABORATORIES</span>
        <span>WORKSPACE 03</span>
      </div>

      <h1>
        Research
        <em>laboratories.</em>
      </h1>

      <p>
        Explore technical research projects, forensic
        experiments and specialist investigation environments.
      </p>
    </header>

    <ProjectExplorer />

    <div id="tt-project-grid" class="project-grid">
      {sortedProjects.map((project) => (
        <div
          class="project-item"
          data-project
          data-title={project.data.title}
          data-search={[
            project.data.title,
            project.data.description,
            project.data.projectId,
            ...[]
          ].join(" ").toLowerCase()}
        >
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            projectId={project.data.projectId}
            status={project.data.status}
            technologies={[]}
            href={`${base}projects/${project.id}/`}
          />
        </div>
      ))}
    </div>

    {sortedProjects.length === 0 && (
      <p class="empty-state">
        No published research projects are currently available.
      </p>
    )}

  </div>
</BaseLayout>

<style>
  .projects-page {
    width: min(100% - 40px, 1200px);
    margin: 0 auto;
    padding: 40px 0 90px;
  }

  .projects-header {
    padding: 30px 0 60px;
    border-top: 1px solid var(--tt-border);
    border-bottom: 1px solid var(--tt-border);
  }

  .header-top {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 15px;
    color: var(--tt-blue);
    font-family: var(--tt-font-mono);
    font-size: 0.75rem;
  }

  h1 {
    margin: 50px 0 25px;
    color: var(--tt-heading);
    font-family: var(--tt-font-editorial);
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 400;
    line-height: 1.05;
  }

  h1 em {
    display: block;
    color: var(--tt-purple);
  }

  .projects-header > p {
    max-width: 650px;
    color: var(--tt-muted);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 35px;
  }

  .project-item {
    min-width: 0;
    display: flex;
  }

  .project-item :global(.project-card) {
    width: 100%;
  }

  .project-item[hidden] {
    display: none !important;
  }

  .empty-state {
    padding: 30px;
    color: var(--tt-muted);
    text-align: center;
  }

  @media (max-width: 750px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>