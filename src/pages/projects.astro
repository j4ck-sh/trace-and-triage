---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Projects | Trace & Triage">

<p class="case-id">PROJECTS</p>

<h1>Projects</h1>

<p class="hero-subtitle">
  Larger technical projects, laboratories and research environments.
</p>


<div class="grid">

  <div class="card">

    <span class="case-id">
      PROJECT-001
    </span>

    <h3>Windows Forensics Lab</h3>

    <p class="muted">
      A controlled Windows environment used to generate,
      collect and analyse forensic artefacts.
    </p>

  </div>


  <div class="card">

    <span class="case-id">
      PROJECT-002
    </span>

    <h3>Malware Analysis Lab</h3>

    <p class="muted">
      An isolated environment for static and dynamic
      malware analysis.
    </p>

  </div>


  <div class="card">

    <span class="case-id">
      PROJECT-003
    </span>

    <h3>Detection Lab</h3>

    <p class="muted">
      Generating attack telemetry and developing
      defensive detections.
    </p>

  </div>

</div>

</BaseLayout>