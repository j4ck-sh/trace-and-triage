---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

// Readingtime function
  import {
    getReadingTime,
    formatReadingTime
  } from "../utils/readingTime";

const base = import.meta.env.BASE_URL;

const articles = await getCollection(
  "research",
  ({ data }) => !data.draft
);

const latestArticles = articles
  .sort(
    (a, b) =>
      b.data.date.valueOf() - a.data.date.valueOf()

  )
  .slice(0, 3);

  

---

<BaseLayout
  title="Trace & Triage"
  description="Digital Forensics, Incident Response and Security Research"
>

<section class="hero">

  <p class="case-id">
    DIGITAL FORENSICS • INCIDENT RESPONSE • SECURITY RESEARCH
  </p>

  <h1>
    Trace <span class="accent">&</span> Triage
  </h1>

  <p class="hero-subtitle">
    Practical investigations into digital evidence,
    malware behaviour, security incidents and
    non-traditional forensic systems.
  </p>

</section>


<section>

  <h2>Latest Research</h2>

  <p class="section-description">
    My latest digital forensic investigations,
    malware analysis and security research.
  </p>

  <div class="grid">

    {latestArticles.map((article) => (

      <a
        class="card"
        href={`${base}research/${article.id}`}
      >

        <span class="case-id">
          {article.data.caseId}
        </span>

        <h3>
          {article.data.title}
        </h3>

        <p class="muted">
          {article.data.description}
        </p>

        <p class="article-meta">
          <span>{article.data.category}</span>

          <span class="meta-seperator">.</span>

          <span>
            {article.data.date.toLocaleTimeString("en-GB")}
          </span>

          <span class="meta-seperator"></span>

          <span class="reading-time">
            {formatReadingTime(getReadingTime(article))}
          </span>
        </p>

        <div class="tags">

          {article.data.tags.map((tag) => (

            <span class="tag">
              {tag}
            </span>

          ))}

        </div>

      </a>

    ))}

  </div>

  <p class="view-all">
    <a href={`${base}research`}>
      View all research →
    </a>
  </p>

</section>

<style>

.article-meta {
  color: var(--muted);
  font-size: 0.85rem;
  margin-top: 15px;
}

.tags {
  margin-top: 15px;
}

.view-all {
  margin-top: 25px;
}

</style>


<section>

  <h2>Research Areas</h2>

  <div class="grid">

    <div class="card">
      <span class="case-id">TT-DF</span>
      <h3>Digital Forensics</h3>
      <p class="muted">
        Windows artefacts, timelines, disk analysis
        and evidence reconstruction.
      </p>
    </div>

    <div class="card">
      <span class="case-id">TT-ML</span>
      <h3>Malware Analysis</h3>
      <p class="muted">
        Static and dynamic analysis of malicious software.
      </p>
    </div>

    <div class="card">
      <span class="case-id">TT-IR</span>
      <h3>Incident Response</h3>
      <p class="muted">
        Investigation and reconstruction of security incidents.
      </p>
    </div>

    <div class="card">
      <span class="case-id">TT-DR</span>
      <h3>Drone Forensics</h3>
      <p class="muted">
        UAV telemetry, GPS and digital evidence.
      </p>
    </div>

    <div class="card">
      <span class="case-id">TT-SP</span>
      <h3>Space Systems</h3>
      <p class="muted">
        Satellite cybersecurity, telemetry and space-system research.
      </p>
    </div>

    <div class="card">
      <span class="case-id">TT-TH</span>
      <h3>Threat Hunting</h3>
      <p class="muted">
        Behaviour-based detection and investigative hunting.
      </p>
    </div>

  </div>

</section>


<section>

  <h2>About Trace & Triage</h2>

  <p class="section-description">
    Trace & Triage documents my practical research across
    digital forensics, incident response, malware analysis
    and security.
  </p>

  <p>
    The focus is not simply on identifying malicious activity,
    but understanding what evidence remains afterwards and how
    that evidence can be used to reconstruct what happened.
  </p>

  <a href="/about">
    More about the project →
  </a>

</section>

</BaseLayout>