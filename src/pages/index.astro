---
import { getCollection } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/HomeHero.astro";
import WorkspaceNav from "../components/WorkspaceNav.astro";
import WorkspacePanel from "../components/WorkspacePanel.astro";
import CommandPanel from "../components/CommandPanel.astro";
import RevealOnScroll from "../components/RevealOnScroll.astro";
import TypewriterHeadings from "../components/TypewriterHeadings.astro";
import MagneticButtons from "../components/MagneticButtons.astro";
import CardSpotlight from "../components/CardSpotlight.astro";
import WorkspaceStatusBar from "../components/WorkspaceStatusBar.astro";
import MotionControls from "../components/MotionControls.astro";

const base = import.meta.env.BASE_URL;

const articles = await getCollection(
  "research",
  ({ data }) => !data.draft
);

const latestResearch = [...articles]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const projects = await getCollection(
  "projects",
  ({ data }) => !data.draft
);

const featuredProjects = projects.slice(0, 3);
---

<BaseLayout
  title="Trace & Triage | Digital Forensics Research"
  description="Independent digital forensics, malware analysis and cybersecurity research."
>
  <div class="tt-home">

    <WorkspaceStatusBar />

    <WorkspaceNav />

    <HomeHero />

    <section class="tt-section" data-reveal>
      <div class="section-heading">
        <p class="tt-label">01 / INVESTIGATION JOURNAL</p>
        <h2 data-typewriter>Latest Research</h2>
      </div>

      <div class="research-grid">
        {latestResearch.map((article) => (
          <a
            class="research-card"
            data-reveal
            data-spotlight
            href={`${base}research/${article.id}/`}
          >
            <span class="tt-label">{article.data.caseId}</span>

            <h3>{article.data.title}</h3>

            <p>{article.data.description}</p>

            <span class="card-link">Read Investigation ↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="tt-section" data-reveal>
      <div class="section-heading">
        <p class="tt-label">02 / TECHNICAL LABORATORIES</p>
        <h2 data-typewriter>Research Workspaces</h2>
      </div>

      <div class="lab-grid">
        {featuredProjects.map((project, index) => (
          <WorkspacePanel
            label={project.data.projectId}
            title={project.data.title}
            description={project.data.description}
            href={`${base}projects/${project.id}/`}
            accent={
              index === 0 ? "blue" :
              index === 1 ? "purple" : "green"
            }
          />
        ))}
      </div>
    </section>

    <section class="tt-section" data-reveal>
      <div class="section-heading">
        <p class="tt-label">03 / COMMAND INTERFACE</p>
        <h2 data-typewriter>Navigate the Archive</h2>
      </div>

      <CommandPanel />
    </section>

  </div>

  <RevealOnScroll />
  <TypewriterHeadings />
  <MagneticButtons />
  <CardSpotlight />
  <WorkspaceStatusBar />
  <MotionControls />
</BaseLayout>

<style>
  .tt-home {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 25px 90px;
  }

  .tt-section {
    margin: 90px 0;
  }

  .section-heading {
    padding-top: 20px;
    margin-bottom: 30px;
    border-top: 1px solid var(--tt-border);
  }

  .section-heading h2 {
    font-family: var(--tt-font-editorial);
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 400;
    color: var(--tt-heading);
  }

  .research-grid,
  .lab-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .research-card {
    display: flex;
    flex-direction: column;
    gap: 15px;
    min-height: 260px;
    padding: 25px;
    background: var(--tt-surface);
    border: 1px solid var(--tt-border);
    border-radius: 6px;
    color: var(--tt-text);
    text-decoration: none;
    transition:
      transform 250ms ease,
      border-color 250ms ease;
  }

  .research-card:hover {
    transform: translateY(-4px);
    border-color: var(--tt-blue);
  }

  .research-card h3 {
    margin: 0;
    font-family: var(--tt-font-editorial);
    font-size: 1.7rem;
    font-weight: 400;
  }

  .research-card p {
    color: var(--tt-muted);
    line-height: 1.7;
  }

  .card-link {
    margin-top: auto;
    color: var(--tt-blue);
    font-family: var(--tt-font-mono);
    font-size: 0.8rem;
  }

  @media (max-width: 850px) {
    .research-grid,
    .lab-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .research-card {
      transition: none;
    }

    .research-card:hover {
      transform: none;
    }
  }
</style>