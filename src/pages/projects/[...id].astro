
---
import {
  getCollection,
  render,
  type CollectionEntry
} from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";

import ProjectHero from "../../components/ProjectHero.astro";
import InvestigationWorkspace from "../../components/InvestigationWorkspace.astro";

// ==========================================
// GENERATE PROJECT ROUTES
// ==========================================

export async function getStaticPaths() {
  const projects = await getCollection(
    "projects",
    ({ data }) => !data.draft
  );

  return projects.map((project) => ({
    params: {
      id: project.id
    },
    props: {
      project
    }
  }));
}

// ==========================================
// PROJECT PROPS
// ==========================================

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props as Props;

// ==========================================
// RENDER PROJECT MARKDOWN
// ==========================================

const { Content, headings } = await render(project);

const tocHeadings = headings.filter(
  (heading) => heading.depth === 2
);

// ==========================================
// PROJECT CONFIGURATION
// ==========================================

const base = import.meta.env.BASE_URL;

// Confirmed Drone Forensics project ID
const isDroneProject = project.id === "drone-forensics";

// Avoid assuming a technology field exists
const technologies: string[] = [];
---

<BaseLayout
  title={`${project.data.title} | Trace & Triage`}
  description={project.data.description}
>
  <article class="tt-project-page">

    <!-- =====================================
         PROJECT HERO
         ===================================== -->

    <ProjectHero
      title={project.data.title}
      description={project.data.description}
      projectId={project.data.projectId}
      status={project.data.status}
      technologies={technologies}
    />

    <!-- =====================================
         PROJECT METADATA
         ===================================== -->

    <section
      class="project-metadata"
      aria-label="Project information"
    >
      <div class="metadata-item">
        <span>PROJECT REFERENCE</span>
        <strong>{project.data.projectId}</strong>
      </div>

      <div class="metadata-item">
        <span>STATUS</span>
        <strong>{project.data.status}</strong>
      </div>

      <div class="metadata-item">
        <span>RESEARCH TYPE</span>
        <strong>Technical Laboratory</strong>
      </div>
    </section>

    <!-- =====================================
         STAGE 68.6 — TABBED DRONE LABORATORY
         ===================================== -->

    {isDroneProject && (
      <section
        class="drone-laboratory"
        aria-label="Interactive Drone Forensics Laboratory"
      >
        <InvestigationWorkspace />
      </section>
    )}

    <!-- =====================================
         PROJECT CONTENTS
         ===================================== -->

    {tocHeadings.length > 0 && (
      <nav
        class="project-contents"
        aria-label="Project table of contents"
        data-pagefind-ignore
      >
        <div class="contents-header">
          <span>TT / PROJECT CONTENTS</span>
          <span>{tocHeadings.length} SECTIONS</span>
        </div>

        <ol>
          {tocHeadings.map((heading, index) => (
            <li>
              <a href={`#${heading.slug}`}>
                <span class="contents-number">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span>{heading.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <!-- =====================================
         PROJECT DOCUMENTATION
         ===================================== -->

    <section
      id="tt-project-documentation"
      class="project-documentation"
      aria-label="Project documentation"
    >
      <div class="documentation-header">
        <span>TT / TECHNICAL DOCUMENTATION</span>
        <span>PROJECT RESEARCH</span>
      </div>

      <div
        class="project-content"
        data-pagefind-body
      >
        <Content />
      </div>
    </section>

    <!-- =====================================
         PROJECT FOOTER
         ===================================== -->

    <footer class="project-footer">
      <div>
        <span class="footer-label">
          END OF PROJECT FILE
        </span>

        <strong>{project.data.projectId}</strong>
      </div>

      <a href={`${base}projects/`}>
        ← Back to Research Projects
      </a>
    </footer>

  </article>
</BaseLayout>

<style>
  /* ==========================================
     TRACE & TRIAGE — STAGE 68.6
     INDIVIDUAL PROJECT DESIGN
     ========================================== */

  /* PAGE LAYOUT */

  .tt-project-page {
    width: min(100% - 40px, 1200px);
    margin: 0 auto;
    padding: 40px 0 90px;
  }

  /* ==========================================
     PROJECT METADATA
     ========================================== */

  .project-metadata {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 15px;
    margin: 35px 0 45px;
  }

  .metadata-item {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    padding: 22px;
    background: var(--tt-surface);
    border: 1px solid var(--tt-border);
    border-radius: var(--tt-radius-md);
  }

  .metadata-item > span {
    color: var(--tt-muted);
    font-family: var(--tt-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.07em;
  }

  .metadata-item > strong {
    color: var(--tt-heading);
    font-size: 1rem;
    overflow-wrap: anywhere;
  }

  /* ==========================================
     DRONE LABORATORY
     ========================================== */

  .drone-laboratory {
    min-width: 0;
    margin: 45px 0 70px;
  }

  /* ==========================================
     PROJECT TABLE OF CONTENTS
     ========================================== */

  .project-contents {
    margin: 55px 0 65px;
    padding: 25px;
    background: var(--tt-deep);
    border: 1px solid var(--tt-border);
    border-radius: var(--tt-radius-md);
  }

  .contents-header {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 15px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--tt-border);
    color: var(--tt-blue);
    font-family: var(--tt-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
  }

  .project-contents ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 20px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .project-contents li {
    min-width: 0;
  }

  .project-contents a {
    display: flex;
    gap: 14px;
    padding: 12px;
    border: 1px solid transparent;
    border-radius: 4px;
    color: var(--tt-text);
    text-decoration: none;
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
  }

  .project-contents a:hover {
    background: var(--tt-raised);
    border-color: var(--tt-border);
  }

  .project-contents a:focus-visible {
    outline: 2px solid var(--tt-blue);
    outline-offset: 3px;
  }

  .contents-number {
    flex-shrink: 0;
    color: var(--tt-purple);
    font-family: var(--tt-font-mono);
    font-size: 0.75rem;
  }

  /* ==========================================
     PROJECT DOCUMENTATION
     ========================================== */

  .project-documentation {
    margin: 65px 0;
    min-width: 0;
    scroll-margin-top: 100px;
  }

  .documentation-header {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 15px;
    padding: 18px 0;
    border-top: 1px solid var(--tt-border);
    border-bottom: 1px solid var(--tt-border);
    color: var(--tt-blue);
    font-family: var(--tt-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.07em;
  }

  .documentation-header span:last-child {
    color: var(--tt-muted);
  }

  .project-content {
    width: 100%;
    max-width: 950px;
    margin: 35px auto 0;
    color: var(--tt-text);
    font-size: 1.02rem;
    line-height: 1.85;
    overflow-wrap: anywhere;
  }

  /* MARKDOWN HEADINGS */

  .project-content :global(h2) {
    margin: 55px 0 25px;
    padding: 18px 0;
    border-top: 1px solid var(--tt-border);
    border-bottom: 1px solid var(--tt-border);
    color: var(--tt-heading);
    font-family: var(--tt-font-editorial);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    scroll-margin-top: 100px;
  }

  .project-content :global(h3) {
    margin: 35px 0 15px;
    color: var(--tt-blue);
    font-size: 1.3rem;
  }

  .project-content :global(h4) {
    margin: 25px 0 12px;
    color: var(--tt-heading);
  }

  /* PARAGRAPHS AND LISTS */

  .project-content :global(p) {
    margin: 18px 0;
    color: var(--tt-text);
    line-height: 1.85;
  }

  .project-content :global(ul),
  .project-content :global(ol) {
    margin: 20px 0;
    padding-left: 25px;
  }

  .project-content :global(li) {
    margin-bottom: 10px;
  }

  /* LINKS */

  .project-content :global(a) {
    color: var(--tt-blue);
    text-underline-offset: 4px;
  }

  .project-content :global(a:hover) {
    color: var(--tt-purple);
  }

  /* CODE BLOCKS */

  .project-content :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    margin: 25px 0;
    padding: 22px;
    background: var(--tt-deep);
    border: 1px solid var(--tt-border);
    border-radius: var(--tt-radius-md);
    line-height: 1.65;
  }

  .project-content :global(:not(pre) > code) {
    padding: 3px 6px;
    background: var(--tt-raised);
    border-radius: 4px;
    color: var(--tt-purple);
  }

  /* TABLES */

  .project-content :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    margin: 30px 0;
    border-collapse: collapse;
  }

  .project-content :global(th),
  .project-content :global(td) {
    padding: 12px 15px;
    border: 1px solid var(--tt-border);
    text-align: left;
  }

  .project-content :global(th) {
    background: var(--tt-surface);
    color: var(--tt-heading);
  }

  /* BLOCKQUOTES */

  .project-content :global(blockquote) {
    margin: 30px 0;
    padding: 20px 25px;
    background: var(--tt-surface);
    border-left: 3px solid var(--tt-purple);
    color: var(--tt-muted);
  }

  /* IMAGES */

  .project-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 30px auto;
    border: 1px solid var(--tt-border);
    border-radius: var(--tt-radius-md);
  }

  /* ==========================================
     PROJECT FOOTER
     ========================================== */

  .project-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 85px;
    padding: 25px 0;
    border-top: 1px solid var(--tt-border);
  }

  .project-footer > div {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-label {
    color: var(--tt-muted);
    font-family: var(--tt-font-mono);
    font-size: 0.75rem;
  }

  .project-footer strong {
    color: var(--tt-heading);
  }

  .project-footer a {
    color: var(--tt-blue);
    font-family: var(--tt-font-mono);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .project-footer a:hover {
    text-decoration: underline;
  }

  /* ==========================================
     RESPONSIVE DESIGN
     ========================================== */

  @media (max-width: 950px) {
    .project-contents ol {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 750px) {
    .project-metadata {
      grid-template-columns: 1fr;
    }

    .tt-project-page {
      width: min(100% - 30px, 1200px);
      padding-top: 25px;
    }

    .project-contents {
      padding: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-contents a {
      transition: none;
    }
  }
</style>