
---
import {
  getCollection,
  render,
  type CollectionEntry
} from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";

// Components
import ImageLightbox from "../../components/ImageLightbox.astro";
import RelatedResearch from "../../components/RelatedResearch.astro";
import ForensicTimeline from "../../components/ForensicTimeline.astro";
import IOCTable from "../../components/IOCTable.astro";
import ResearchCallout from "../../components/ResearchCallout.astro";
import FrameworkMapping from "../../components/FrameworkMapping.astro";
import ShareArticle from "../../components/ShareArticle.astro";

// Utilities
import {
  getReadingTime,
  formatReadingTime
} from "../../utils/readingTime";

// ==========================================
// GENERATE RESEARCH ARTICLE PAGES
// ==========================================

export async function getStaticPaths() {
  const articles = await getCollection(
    "research",
    ({ data }) => !data.draft
  );

  return articles.map((article) => ({
    params: {
      id: article.id
    },
    props: {
      article
    }
  }));
}

// ==========================================
// ARTICLE TYPES
// ==========================================

interface Props {
  article: CollectionEntry<"research">;
}

const { article } = Astro.props as Props;

// Render Markdown and extract headings
const { Content, headings } = await render(article);

// ==========================================
// AUTOMATIC TABLE OF CONTENTS
// ==========================================

const tocHeadings = headings.filter(
  (heading) =>
    heading.depth === 2 ||
    heading.depth === 3
);

// ==========================================
// AUTOMATIC READING TIME
// ==========================================

const readingLabel = formatReadingTime(
  getReadingTime(article)
);

// ==========================================
// URLS AND HERO IMAGE
// ==========================================

const base = import.meta.env.BASE_URL;

// Full public URL for sharing
const articleUrl = Astro.url.toString();

// Convert image path for GitHub Pages
const heroImageUrl = article.data.heroImage
  ? `${base}${article.data.heroImage.replace(/^\/+/, "")}`
  : undefined;

// ==========================================
// ARTICLE STATUS
// ==========================================

const statusClass = article.data.status
  .toLowerCase()
  .replace(/\s+/g, "-");
---

<BaseLayout
  title={`${article.data.title} | Trace & Triage`}
  description={article.data.description}
  image={article.data.heroImage}
  type="article"
  publishedDate={article.data.date}
>

  <article class="research-article">

    <!-- ARTICLE HEADER -->

    <header class="article-header">

      <div class="article-top">
        <span class="case-id">
          {article.data.caseId}
        </span>

        <span class="article-category">
          {article.data.category}
        </span>
      </div>

      <h1>{article.data.title}</h1>

      <p class="article-description">
        {article.data.description}
      </p>

      <!-- HERO IMAGE -->

      {heroImageUrl && (
        <img
          class="hero-image"
          src={heroImageUrl}
          alt={article.data.heroImageAlt ?? article.data.title}
          loading="eager"
          decoding="async"
        />
      )}

      <!-- ARTICLE METADATA -->

      <div class="article-metadata">

        <span>
          {article.data.date.toLocaleDateString(
            "en-GB",
            {
              day: "numeric",
              month: "long",
              year: "numeric"
            }
          )}
        </span>

        <span class="reading-time">
          {readingLabel}
        </span>

        {article.data.difficulty && (
          <span>{article.data.difficulty}</span>
        )}

        <span class:list={["article-status", statusClass]}>
          {article.data.status}
        </span>

      </div>

      <!-- ARTICLE TAGS -->

      {article.data.tags.length > 0 && (
        <div class="article-tags">
          {article.data.tags.map((tag) => (
            <span class="article-tag">{tag}</span>
          ))}
        </div>
      )}

    </header>

    <!-- INVESTIGATION SUMMARY -->

    <section class="investigation-summary">

      <h2>Investigation Summary</h2>

      <div class="summary-grid">

        <div>
          <strong>Case Reference</strong>
          <span>{article.data.caseId}</span>
        </div>

        <div>
          <strong>Category</strong>
          <span>{article.data.category}</span>
        </div>

        <div>
          <strong>Platform</strong>
          <span>{article.data.platform ?? "Not specified"}</span>
        </div>

        <div>
          <strong>Environment</strong>
          <span>{article.data.environment ?? "Not specified"}</span>
        </div>

        <div>
          <strong>Difficulty</strong>
          <span>{article.data.difficulty ?? "Not specified"}</span>
        </div>

        <div>
          <strong>Status</strong>
          <span>{article.data.status}</span>
        </div>

        {article.data.subject && (
          <div>
            <strong>Subject</strong>
            <span>{article.data.subject}</span>
          </div>
        )}

      </div>

      {article.data.tools.length > 0 && (
        <div class="summary-tools">
          <strong>Tools Used</strong>
          <p>{article.data.tools.join(" • ")}</p>
        </div>
      )}

    </section>

    <!-- AUTOMATIC TABLE OF CONTENTS -->

    {tocHeadings.length > 0 && (
      <nav
        class="table-of-contents"
        aria-label="Article table of contents"
        data-pagefind-ignore
      >

        <div class="toc-header">
          <span class="toc-label">
            ARTICLE CONTENTS
          </span>

          <span class="toc-count">
            {tocHeadings.length} sections
          </span>
        </div>

        <ol class="toc-list">
          {tocHeadings.map((heading, index) => (
            <li
              class:list={[
                "toc-item",
                {
                  "toc-subsection": heading.depth === 3
                }
              ]}
            >
              <a href={`#${heading.slug}`}>
                <span class="toc-number">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <span>{heading.text}</span>
              </a>
            </li>
          ))}
        </ol>

      </nav>
    )}

    <!-- MAIN MARKDOWN ARTICLE -->

    <div class="article-content" data-pagefind-body>
      <Content />
    </div>

    <!-- SCREENSHOT LIGHTBOX -->

    <ImageLightbox />

    <!-- FORENSIC TIMELINE -->

    {article.data.timeline.length > 0 && (
      <ForensicTimeline
        events={article.data.timeline}
      />
    )}

    <!-- INDICATORS OF COMPROMISE -->

    {article.data.indicators.length > 0 && (
      <IOCTable
        indicators={article.data.indicators}
      />
    )}

    <!-- EVIDENCE AND FINDINGS -->

    {article.data.callouts.length > 0 && (
      <section class="research-findings">

        <h2>Investigation Findings & Notes</h2>

        {article.data.callouts.map((callout) => (
          <ResearchCallout
            type={callout.type}
            title={callout.title}
            text={callout.text}
            reference={callout.reference}
          />
        ))}

      </section>
    )}

    <!-- MITRE ATT&CK MAPPING -->

    {article.data.attackTechniques.length > 0 && (
      <FrameworkMapping
        framework="MITRE ATT&CK"
        techniques={article.data.attackTechniques}
      />
    )}

    <!-- SPARTA MAPPING -->

    {article.data.spartaTechniques.length > 0 && (
      <FrameworkMapping
        framework="SPARTA"
        techniques={article.data.spartaTechniques}
      />
    )}

    <!-- REFERENCES -->

    {article.data.references.length > 0 && (
      <section class="references">

        <h2>References</h2>

        <ul>
          {article.data.references.map((reference) => (
            <li>
              <a
                href={reference.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {reference.title}
              </a>
            </li>
          ))}
        </ul>

      </section>
    )}

    <!-- SUPPORTING GITHUB REPOSITORY -->

    {article.data.githubUrl && (
      <section class="supporting-repository">

        <p class="case-id">SUPPORTING MATERIAL</p>

        <h2>Research Repository</h2>

        <p>
          Explore supporting documentation, research scripts,
          sanitised evidence and additional technical material
          associated with this investigation.
        </p>

        <a
          href={article.data.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          View Supporting Repository on GitHub ↗
        </a>

      </section>
    )}

    <!-- RESEARCH METHODOLOGY -->

    <section class="methodology-reference">

      <p class="case-id">RESEARCH STANDARDS</p>

      <h2>Research Methodology</h2>

      <p>
        This investigation follows the general research
        and evidence-handling principles documented by
        Trace & Triage.

        Investigation-specific methods and limitations
        are described within the article.
      </p>

      <a href={`${base}methodology/`}>
        View Research Methodology →
      </a>

    </section>

    <!-- SHARE ARTICLE -->

    <ShareArticle
      title={article.data.title}
      url={articleUrl}
    />

    <!-- RELATED RESEARCH -->

    <RelatedResearch currentArticle={article} />

    <!-- ARTICLE FOOTER -->

    <footer class="article-footer">

      <p class="case-id">
        {article.data.caseId}
      </p>

      <p>
        Trace & Triage — Digital Forensics,
        Incident Response & Security Research
      </p>

      <a href={`${base}research/`}>
        ← Back to Research
      </a>

    </footer>

  </article>

</BaseLayout>

<style>
  /* ==========================================
     RESEARCH ARTICLE LAYOUT
     ========================================== */

  .research-article {
    max-width: 900px;
    margin: 0 auto;
  }

  /* ARTICLE HEADER */

  .article-header {
    padding: 50px 0 40px;
    border-bottom: 1px solid var(--border);
  }

  .article-top {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 15px;
  }

  .article-category {
    color: var(--muted);
    font-family: Consolas, monospace;
    font-size: 0.85rem;
    text-transform: uppercase;
  }

  .article-header h1 {
    margin: 20px 0;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.15;
  }

  .article-description {
    color: var(--muted);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  /* HERO IMAGE */

  .hero-image {
    display: block;
    width: 100%;
    height: auto;
    margin: 30px 0;
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  /* ARTICLE METADATA */

  .article-metadata {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin: 25px 0;
    color: var(--muted);
    font-family: Consolas, monospace;
    font-size: 0.85rem;
  }

  .reading-time {
    color: var(--accent);
    font-weight: 600;
  }

  .article-status {
    padding: 5px 9px;
    border: 1px solid var(--border);
    border-radius: 6px;
  }

  .article-status.completed {
    color: #86c7aa;
  }

  .article-status.in-progress {
    color: #e5b96c;
  }

  /* TAGS */

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .article-tag {
    padding: 5px 10px;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--muted);
    font-size: 0.8rem;
  }

  /* INVESTIGATION SUMMARY */

  .investigation-summary {
    margin: 45px 0;
    padding: 30px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .investigation-summary h2 {
    margin: 0 0 25px;
    color: var(--accent);
    font-size: 1.25rem;
  }

  .summary-grid {
    display: grid;
    grid-template-columns:
      repeat(auto-fit, minmax(180px, 1fr));
    gap: 25px;
  }

  .summary-grid > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .summary-grid strong,
  .summary-tools strong {
    color: var(--muted);
    font-family: Consolas, monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .summary-tools {
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }

  .summary-tools p {
    color: var(--text);
    margin-bottom: 0;
  }

  /* MARKDOWN CONTENT */

  .article-content {
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  .article-content :global(h2) {
    margin-top: 55px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
    scroll-margin-top: 35px;
  }

  .article-content :global(h3) {
    margin-top: 35px;
    scroll-margin-top: 35px;
  }

  .article-content :global(p) {
    margin: 18px 0;
  }

  .article-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 30px auto 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    cursor: zoom-in;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .article-content :global(img:hover) {
    border-color: var(--accent);
    box-shadow: 0 8px 35px rgba(82, 199, 234, 0.15);
  }

  .article-content :global(img:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  .article-content :global(p > em:only-child) {
    display: block;
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
    margin-bottom: 35px;
  }

  .article-content :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 30px 0;
  }

  .article-content :global(th),
  .article-content :global(td) {
    padding: 12px;
    border: 1px solid var(--border);
    text-align: left;
  }

  .article-content :global(th) {
    background: var(--surface);
  }

  .article-content :global(pre) {
    padding: 20px;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  .article-content :global(blockquote) {
    margin: 25px 0;
    padding: 15px 20px;
    border-left: 3px solid var(--accent);
    background: var(--surface);
    color: var(--muted);
  }

  /* FINDINGS */

  .research-findings {
    margin: 55px 0;
  }

  .research-findings > h2 {
    margin-bottom: 30px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }

  /* REFERENCES */

  .references {
    margin-top: 55px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }

  .references li {
    margin-bottom: 10px;
  }

  /* SUPPORTING REPOSITORY */

  .supporting-repository {
    margin: 45px 0;
    padding: 25px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .supporting-repository h2 {
    margin: 10px 0;
    font-size: 1.3rem;
  }

  .supporting-repository p {
    color: var(--muted);
    line-height: 1.7;
  }

  .supporting-repository a {
    display: inline-block;
    margin-top: 12px;
    color: var(--accent);
    font-weight: 600;
  }

  /* METHODOLOGY */

  .methodology-reference {
    margin-top: 60px;
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .methodology-reference h2 {
    margin: 10px 0 15px;
    font-size: 1.3rem;
  }

  .methodology-reference p {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .methodology-reference a {
    display: inline-block;
    margin-top: 10px;
    color: var(--accent);
    font-weight: 600;
  }

  /* FOOTER */

  .article-footer {
    margin-top: 70px;
    padding: 25px 0;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
  }

  .article-footer a {
    display: inline-block;
    margin-top: 15px;
    color: var(--accent);
  }

  /* MOBILE */

  @media (max-width: 600px) {
    .article-header {
      padding: 30px 0;
    }

    .investigation-summary {
      padding: 20px;
    }

    .methodology-reference,
    .supporting-repository {
      padding: 20px;
    }

    .article-metadata {
      gap: 12px;
      font-size: 0.8rem;
    }
  }
</style>