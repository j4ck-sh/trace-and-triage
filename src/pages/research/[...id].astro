
---
import {
  getCollection,
  render,
  type CollectionEntry
} from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import ResearchVisualisations from "../../components/ResearchVisualisations.astro";

// Existing forensic components
import ImageLightbox from "../../components/ImageLightbox.astro";
import RelatedResearch from "../../components/RelatedResearch.astro";
import ForensicTimeline from "../../components/ForensicTimeline.astro";
import IOCTable from "../../components/IOCTable.astro";
import ResearchCallout from "../../components/ResearchCallout.astro";
import FrameworkMapping from "../../components/FrameworkMapping.astro";
import ShareArticle from "../../components/ShareArticle.astro";

// Stage 66 components
import ArticleHero from "../../components/ArticleHero.astro";
import ReadingProgress from "../../components/ReadingProgress.astro";
import ActiveArticleSection from "../../components/ActiveArticleSection.astro";
import ArticleInteractions from "../../components/ArticleInteractions.astro";

// Reading-time utilities
import {
  getReadingTime,
  formatReadingTime
} from "../../utils/readingTime";

// ==========================================
// GENERATE RESEARCH ARTICLE ROUTES
// ==========================================

export async function getStaticPaths() {
  const articles = await getCollection(
    "research",
    ({ data }) => !data.draft
  );

  return articles.map((article) => ({
    params: {
      id: article.id
    },
    props: {
      article
    }
  }));
}

// ==========================================
// ARTICLE PROPS
// ==========================================

interface Props {
  article: CollectionEntry<"research">;
}

const { article } = Astro.props as Props;

// ==========================================
// RENDER ARTICLE CONTENT
// ==========================================

const { Content, headings } = await render(article);

const tocHeadings = headings.filter(
  (heading) =>
    heading.depth === 2 ||
    heading.depth === 3
);

// ==========================================
// READING TIME
// ==========================================

const readingLabel = formatReadingTime(
  getReadingTime(article)
);

// ==========================================
// URLS AND HERO IMAGE
// ==========================================

const base = import.meta.env.BASE_URL;

const articleUrl = Astro.url.toString();

const heroImageUrl = article.data.heroImage
  ? `${base}${article.data.heroImage.replace(/^\/+/, "")}`
  : undefined;

// ==========================================
// ARTICLE STATUS
// ==========================================

const statusClass = article.data.status
  .toLowerCase()
  .replace(/\s+/g, "-");
---

<BaseLayout
  title={`${article.data.title} | Trace & Triage`}
  description={article.data.description}
  image={article.data.heroImage}
  type="article"
  publishedDate={article.data.date}
>
  <!-- READING PROGRESS -->

  <ReadingProgress />

  <article class="research-article">

    <!-- =====================================
         ARTICLE HEADER
         ===================================== -->

    <ArticleHero
      title={article.data.title}
      description={article.data.description}
      caseId={article.data.caseId}
      category={article.data.category}
      date={article.data.date}
      readingTime={readingLabel}
      tags={article.data.tags ?? []}
    />

    <!-- HERO IMAGE -->

    {heroImageUrl && (
      <figure class="article-hero-figure">
        <img
          class="hero-image"
          src={heroImageUrl}
          alt={article.data.heroImageAlt ?? article.data.title}
          loading="eager"
          decoding="async"
        />
      </figure>
    )}

    <!-- ARTICLE STATUS AND DIFFICULTY -->

    <div class="article-details">
      <span class:list={["article-status", statusClass]}>
        {article.data.status}
      </span>

      {article.data.difficulty && (
        <span class="article-difficulty">
          DIFFICULTY / {article.data.difficulty}
        </span>
      )}
    </div>

    <!-- =====================================
         INVESTIGATION SUMMARY
         ===================================== -->

    <section class="investigation-summary">

      <div class="section-heading">
        <span class="section-label">
          TT / INVESTIGATION METADATA
        </span>

        <h2>Investigation Summary</h2>
      </div>

      <div class="summary-grid">

        <div>
          <strong>Case Reference</strong>
          <span>{article.data.caseId}</span>
        </div>

        <div>
          <strong>Category</strong>
          <span>{article.data.category}</span>
        </div>

        <div>
          <strong>Platform</strong>
          <span>
            {article.data.platform ?? "Not specified"}
          </span>
        </div>

        <div>
          <strong>Environment</strong>
          <span>
            {article.data.environment ?? "Not specified"}
          </span>
        </div>

        <div>
          <strong>Difficulty</strong>
          <span>
            {article.data.difficulty ?? "Not specified"}
          </span>
        </div>

        <div>
          <strong>Status</strong>
          <span>{article.data.status}</span>
        </div>

        {article.data.subject && (
          <div>
            <strong>Subject</strong>
            <span>{article.data.subject}</span>
          </div>
        )}

      </div>

      {article.data.tools.length > 0 && (
        <div class="summary-tools">
          <strong>Tools Used</strong>
          <p>{article.data.tools.join(" • ")}</p>
        </div>
      )}

    </section>

    <!-- =====================================
         ARTICLE NAVIGATION AND CONTENT
         ===================================== -->

    <div class="tt-article-layout">

      <!-- STICKY TABLE OF CONTENTS -->

      <aside
        class="tt-article-sidebar"
        aria-label="Article navigation"
      >

        {tocHeadings.length > 0 && (
          <nav
            class="table-of-contents"
            aria-label="Article table of contents"
            data-pagefind-ignore
          >

            <div class="toc-header">
              <span class="toc-label">
                ARTICLE CONTENTS
              </span>

              <span class="toc-count">
                {tocHeadings.length} sections
              </span>
            </div>

            <ol class="toc-list">
              {tocHeadings.map((heading, index) => (
                <li
                  class:list={[
                    "toc-item",
                    {
                      "toc-subsection": heading.depth === 3
                    }
                  ]}
                >
                  <a href={`#${heading.slug}`}>
                    <span class="toc-number">
                      {String(index + 1).padStart(2, "0")}
                    </span>

                    <span>{heading.text}</span>
                  </a>
                </li>
              ))}
            </ol>

          </nav>
        )}

      </aside>

      <!-- MAIN MARKDOWN CONTENT -->

      <div
        class="article-content"
        data-article-content
        data-pagefind-body
      >
        <Content />
      </div>

    </div>

    <ResearchVisualisations articleId={article.id} />

    <!-- ARTICLE INTERACTION SCRIPTS -->

    <ActiveArticleSection />

    <!-- SCREENSHOT LIGHTBOX -->

    <ImageLightbox />

    <!-- =====================================
         FORENSIC TIMELINE
         ===================================== -->

    {article.data.timeline.length > 0 && (
      <section class="forensic-section">
        <ForensicTimeline
          events={article.data.timeline}
        />
      </section>
    )}

    <!-- =====================================
         INDICATORS OF COMPROMISE
         ===================================== -->

    {article.data.indicators.length > 0 && (
      <section class="forensic-section">
        <IOCTable
          indicators={article.data.indicators}
        />
      </section>
    )}

    <!-- =====================================
         INVESTIGATION FINDINGS
         ===================================== -->

    {article.data.callouts.length > 0 && (
      <section class="research-findings">

        <div class="section-heading">
          <span class="section-label">
            TT / EVIDENCE AND FINDINGS
          </span>

          <h2>Investigation Findings & Notes</h2>
        </div>

        <div class="findings-list">
          {article.data.callouts.map((callout) => (
            <ResearchCallout
              type={callout.type}
              title={callout.title}
              text={callout.text}
              reference={callout.reference}
            />
          ))}
        </div>

      </section>
    )}

    <!-- =====================================
         MITRE ATT&CK MAPPING
         ===================================== -->

    {article.data.attackTechniques.length > 0 && (
      <section class="forensic-section">
        <FrameworkMapping
          framework="MITRE ATT&CK"
          techniques={article.data.attackTechniques}
        />
      </section>
    )}

    <!-- =====================================
         SPARTA MAPPING
         ===================================== -->

    {article.data.spartaTechniques.length > 0 && (
      <section class="forensic-section">
        <FrameworkMapping
          framework="SPARTA"
          techniques={article.data.spartaTechniques}
        />
      </section>
    )}

    <!-- =====================================
         REFERENCES
         ===================================== -->

    {article.data.references.length > 0 && (
      <section class="references">

        <div class="section-heading">
          <span class="section-label">
            TT / SOURCE MATERIAL
          </span>

          <h2>References</h2>
        </div>

        <ul>
          {article.data.references.map((reference) => (
            <li>
              <a
                href={reference.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {reference.title}
                <span aria-hidden="true"> ↗</span>
              </a>
            </li>
          ))}
        </ul>

      </section>
    )}

    <!-- =====================================
         SUPPORTING GITHUB REPOSITORY
         ===================================== -->

    {article.data.githubUrl && (
      <section class="supporting-repository">

        <p class="section-label">
          TT / SUPPORTING MATERIAL
        </p>

        <h2>Research Repository</h2>

        <p>
          Explore supporting documentation,
          research scripts, sanitised evidence
          and additional technical material
          associated with this investigation.
        </p>

        <a
          href={article.data.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          View Supporting Repository on GitHub
          <span aria-hidden="true"> ↗</span>
        </a>

      </section>
    )}

    <!-- =====================================
         RESEARCH METHODOLOGY
         ===================================== -->

    <section class="methodology-reference">

      <p class="section-label">
        TT / RESEARCH STANDARDS
      </p>

      <h2>Research Methodology</h2>

      <p>
        This investigation follows the general
        research and evidence-handling principles
        documented by Trace & Triage.
      </p>

      <p>
        Investigation-specific methods and
        limitations are described within the article.
      </p>

      <a href={`${base}methodology/`}>
        View Research Methodology
        <span aria-hidden="true"> ↗</span>
      </a>

    </section>

    <!-- =====================================
         ARTICLE INTERACTIONS
         ===================================== -->

    <ArticleInteractions />

    <!-- SHARE ARTICLE -->

    <ShareArticle
      title={article.data.title}
      url={articleUrl}
    />

    <!-- =====================================
         RELATED RESEARCH
         ===================================== -->

    <RelatedResearch currentArticle={article} />

    <!-- =====================================
         ARTICLE FOOTER
         ===================================== -->

    <footer class="article-footer">

      <div class="footer-top">
        <span class="section-label">
          {article.data.caseId}
        </span>

        <span>END OF CASE FILE</span>
      </div>

      <p>
        Trace & Triage — Digital Forensics,
        Incident Response & Security Research
      </p>

      <a href={`${base}research/`}>
        ← Back to Research Archive
      </a>

    </footer>

  </article>

</BaseLayout>

<style>
  /* ==========================================
     TRACE & TRIAGE — STAGE 66
     RESEARCH ARTICLE DESIGN
     ========================================== */

  .research-article {
    width: min(100% - 40px, 1250px);
    margin: 0 auto;
    padding: 35px 0 90px;
  }

  /* HERO IMAGE */

  .article-hero-figure {
    margin: 35px 0;
  }

  .hero-image {
    display: block;
    width: 100%;
    max-height: 540px;
    object-fit: cover;
    height: auto;
    border: 1px solid var(--tt-border);
    border-radius: var(--tt-radius-md);
  }

  /* STATUS AND DIFFICULTY */

  .article-details {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin: 25px 0;
  }

  .article-status,
  .article-difficulty {
    display: inline-flex;
    align-items: center;
    padding: 7px 11px;
    border: 1px solid var(--tt-border);
    border-radius: 4px;
    font-family: var(--tt-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .article-status {
    color: var(--tt-blue);
  }

  .article-status.completed {
    color: var(--tt-green);
  }

  .article-status.in-progress {
    color: var(--tt-orange);
  }

  .article-difficulty {
    color: var(--tt-muted);
  }

  /* SECTION HEADINGS */

  .section-heading {
    margin-bottom: 25px;
  }

  .section-label {
    color: var(--tt-purple);
    font-family: var(--tt-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-heading h2 {
    margin: 12px 0 0;
    color: var(--tt-heading);
    font-family: var(--tt-font-editorial);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 400;
    line-height: 1.2;
  }

  /* ==========================================
     INVESTIGATION SUMMARY
     ========================================== */

  .investigation-summary {
    margin: 45px 0 60px;
    padding: 30px;
    background: var(--tt-surface);
    border: 1px solid var(--tt-border);
    border-radius: var(--tt-radius-md);
  }

  .summary-grid {
    display: grid;
    grid-template-columns:
      repeat(auto-fit, minmax(170px, 1fr));
    gap: 25px;
  }

  .summary-grid > div {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .summary-grid strong,
  .summary-tools strong {
    color: var(--tt-muted);
    font-family: var(--tt-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .summary-grid span {
    color: var(--tt-heading);
    overflow-wrap: anywhere;
  }

  .summary-tools {
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid var(--tt-border);
  }

  .summary-tools p {
    margin: 10px 0 0;
    color: var(--tt-text);
    line-height: 1.7;
  }

  /* ==========================================
     STICKY ARTICLE LAYOUT
     ========================================== */

  .tt-article-layout {
    display: grid;
    grid-template-columns:
      minmax(210px, 250px)
      minmax(0, 1fr);
    align-items: start;
    gap: clamp(25px, 4vw, 65px);
    margin: 55px 0;
  }

  .tt-article-sidebar {
    position: sticky;
    top: 95px;
    max-height: calc(100vh - 115px);
    overflow-y: auto;
    min-width: 0;
  }

  .table-of-contents {
    margin: 0;
    padding: 20px;
    background: var(--tt-deep);
    border: 1px solid var(--tt-border);
    border-radius: var(--tt-radius-md);
  }

  .toc-header {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-bottom: 15px;
    border-bottom: 1px solid var(--tt-border);
  }

  .toc-label,
  .toc-count {
    color: var(--tt-blue);
    font-family: var(--tt-font-mono);
    font-size: 0.7rem;
  }

  .toc-list {
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .toc-item {
    margin: 5px 0;
  }

  .toc-item a {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 9px;
    border-left: 2px solid transparent;
    border-radius: 3px;
    color: var(--tt-muted);
    font-size: 0.85rem;
    line-height: 1.5;
    text-decoration: none;
    transition:
      color 200ms ease,
      background-color 200ms ease;
  }

  .toc-item a:hover {
    background: var(--tt-raised);
    color: var(--tt-heading);
  }

  .toc-number {
    flex-shrink: 0;
    color: var(--tt-purple);
    font-family: var(--tt-font-mono);
    font-size: 0.7rem;
  }

  .toc-subsection {
    padding-left: 14px;
  }

  /* ==========================================
     ARTICLE CONTENT
     ========================================== */

  .article-content {
    min-width: 0;
    max-width: 850px;
    overflow-wrap: anywhere;
    line-height: 1.85;
  }

  .article-content :global(h2),
  .article-content :global(h3) {
    scroll-margin-top: 110px;
  }

  .article-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 30px auto 12px;
    border: 1px solid var(--tt-border);
    border-radius: var(--tt-radius-md);
    cursor: zoom-in;
  }

  .article-content :global(img:hover) {
    border-color: var(--tt-blue);
  }

  .article-content :global(img:focus-visible) {
    outline: 2px solid var(--tt-blue);
    outline-offset: 4px;
  }

  .article-content :global(p > em:only-child) {
    display: block;
    margin-bottom: 30px;
    color: var(--tt-muted);
    font-size: 0.85rem;
    text-align: center;
  }

  /* ==========================================
     FORENSIC SECTIONS
     ========================================== */

  .forensic-section {
    margin: 60px 0;
    min-width: 0;
  }

  .research-findings {
    margin: 65px 0;
  }

  .findings-list {
    display: grid;
    gap: 15px;
  }

  /* ==========================================
     REFERENCES
     ========================================== */

  .references {
    margin: 65px 0;
    padding-top: 25px;
    border-top: 1px solid var(--tt-border);
  }

  .references ul {
    padding-left: 22px;
  }

  .references li {
    margin: 12px 0;
    overflow-wrap: anywhere;
  }

  .references a {
    color: var(--tt-blue);
  }

  /* ==========================================
     SUPPORTING REPOSITORY
     ========================================== */

  .supporting-repository {
    margin: 50px 0;
    padding: 30px;
    background: var(--tt-surface);
    border: 1px solid var(--tt-border);
    border-left: 3px solid var(--tt-green);
    border-radius: var(--tt-radius-md);
  }

  .supporting-repository h2 {
    margin: 12px 0;
    color: var(--tt-heading);
    font-family: var(--tt-font-editorial);
    font-size: 1.8rem;
    font-weight: 400;
  }

  .supporting-repository p {
    color: var(--tt-muted);
    line-height: 1.8;
  }

  .supporting-repository a {
    display: inline-block;
    margin-top: 12px;
    color: var(--tt-blue);
  }

  /* ==========================================
     METHODOLOGY
     ========================================== */

  .methodology-reference {
    margin: 60px 0;
    padding: 30px;
    background: var(--tt-deep);
    border: 1px solid var(--tt-border);
    border-left: 3px solid var(--tt-purple);
    border-radius: var(--tt-radius-md);
  }

  .methodology-reference h2 {
    margin: 12px 0;
    color: var(--tt-heading);
    font-family: var(--tt-font-editorial);
    font-size: 1.8rem;
    font-weight: 400;
  }

  .methodology-reference p {
    max-width: 750px;
    color: var(--tt-muted);
    line-height: 1.8;
  }

  .methodology-reference a {
    display: inline-block;
    margin-top: 12px;
    color: var(--tt-blue);
  }

  /* ==========================================
     ARTICLE FOOTER
     ========================================== */

  .article-footer {
    margin-top: 75px;
    padding: 25px 0;
    border-top: 1px solid var(--tt-border);
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 15px;
    margin-bottom: 25px;
  }

  .footer-top > span:last-child {
    color: var(--tt-muted);
    font-family: var(--tt-font-mono);
    font-size: 0.75rem;
  }

  .article-footer p {
    color: var(--tt-muted);
    font-size: 0.9rem;
  }

  .article-footer a {
    display: inline-block;
    margin-top: 15px;
    color: var(--tt-blue);
  }

  /* ==========================================
     RESPONSIVE DESIGN
     ========================================== */

  @media (max-width: 950px) {
    .tt-article-layout {
      grid-template-columns: 1fr;
    }

    .tt-article-sidebar {
      position: static;
      max-height: none;
      overflow: visible;
    }
  }

  @media (max-width: 650px) {
    .research-article {
      width: min(100% - 30px, 1250px);
      padding-top: 20px;
    }

    .investigation-summary,
    .supporting-repository,
    .methodology-reference {
      padding: 20px;
    }

    .tt-article-layout {
      margin: 35px 0;
    }

    .table-of-contents {
      padding: 15px;
    }

    .summary-grid {
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
  }

  @media (max-width: 420px) {
    .summary-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-item a {
      transition: none;
    }
  }
</style>