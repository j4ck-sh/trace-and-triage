<div class="tt-ambient" aria-hidden="true">
  <div class="tt-ambient-grid"></div>
  <div class="tt-ambient-glow"></div>
  <div class="tt-ambient-scan"></div>
</div>

<style>
  .tt-ambient {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    border-radius: inherit;
    background:
      radial-gradient(
        ellipse at 80% 30%,
        rgba(122, 162, 247, 0.07),
        transparent 60%
      );
  }

  .tt-ambient-grid {
    position: absolute;
    inset: -40px;
    background-image:
      linear-gradient(
        color-mix(in srgb, var(--tt-blue) 7%, transparent),
        transparent 1px
      ),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--tt-blue) 7%, transparent),
        transparent 1px
      );
    background-size: 42px 42px;
    mask-image:
      linear-gradient(to bottom, black, transparent);
  }

  .tt-ambient-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      320px circle at
      var(--pointer-x, 65%),
      var(--pointer-y, 40%),
      color-mix(in srgb, var(--tt-purple) 15%, transparent),
      transparent 75%,
    );
  }

  .tt-ambient-scan {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(122, 162, 247, 0.45),
      transparent
    );
  }

  @media (prefers-reduced-motion: no-preference) {
    .tt-ambient-grid {
      animation: grid-drift 28s linear infinite;
    }

    .tt-ambient-scan {
      animation: scan-move 12s linear infinite;
    }
  }

  @keyframes grid-drift {
    to {
      transform: translate(42px, 42px);
    }
  }

  @keyframes scan-move {
    from { top: 0; }
    to { top: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tt-ambient-grid,
    .tt-ambient-scan {
      animation: none !important;
    }
  }
</style>

<script>
  const motionQuery = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  );

  document.querySelectorAll<HTMLElement>(
    ".tt-home-hero"
  ).forEach((hero) => {
    if (hero.dataset.ambientReady) return;
    hero.dataset.ambientReady = "true";

    let frame = 0;

    hero.addEventListener("pointermove", (event) => {
      if (
        motionQuery.matches ||
        document.documentElement.classList.contains(
          "tt-motion-paused"
        ) || event.pointerType !== "mouse"
      ) return;

      if (frame) return;

      frame = requestAnimationFrame(() => {
        const rect = hero.getBoundingClientRect();

        hero.style.setProperty(
          "--pointer-x",
          `${event.clientX - rect.left}px`
        );

        hero.style.setProperty(
          "--pointer-y",
          `${event.clientY - rect.top}px`
        );

        frame = 0;
      });
    });

    hero.addEventListener("pointerleave", () => {
      hero.style.removeProperty("--pointer-x");
      hero.style.removeProperty("--pointer-y");
    });
  });
</script>