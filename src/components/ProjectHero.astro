---
interface Props {
  title: string;
  description: string;
  projectId: string;
  status?: string;
  technologies?: string[];
}

const {
  title,
  description,
  projectId,
  status = "Research",
  technologies = []
} = Astro.props;
---

<header class="project-hero">
  <div class="hero-top">
    <span>TT / TECHNICAL LABORATORY</span>
    <span>{projectId}</span>
  </div>

  <h1>{title}</h1>
  <p class="hero-description">{description}</p>

  <div class="hero-bottom">
    <span class="hero-status">{status}</span>

    {technologies.length > 0 && (
      <div class="hero-tech">
        {technologies.map((tech) => (
          <span>{tech}</span>
        ))}
      </div>
    )}
  </div>
</header>

<style>
  .project-hero {
    padding: 30px 0 45px;
    border-top: 1px solid var(--tt-border);
    border-bottom: 1px solid var(--tt-border);
  }

  .hero-top {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 15px;
    color: var(--tt-blue);
    font-family: var(--tt-font-mono);
    font-size: 0.75rem;
  }

  h1 {
    margin: 50px 0 25px;
    color: var(--tt-heading);
    font-family: var(--tt-font-editorial);
    font-size: clamp(2.8rem, 6vw, 5.5rem);
    font-weight: 400;
    line-height: 1.05;
  }

  .hero-description {
    max-width: 800px;
    color: var(--tt-muted);
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .hero-bottom {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: 35px;
  }

  .hero-status,
  .hero-tech span {
    padding: 6px 10px;
    border: 1px solid var(--tt-border);
    border-radius: 4px;
    color: var(--tt-muted);
    font-family: var(--tt-font-mono);
    font-size: 0.75rem;
  }

  .hero-status {
    color: var(--tt-green);
  }

  .hero-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>