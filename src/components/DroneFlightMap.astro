
---
interface Props {
  title?: string;
}

const {
  title = "Flight Reconstruction Map"
} = Astro.props;
---

<section class="drone-map-section">
  <div class="map-heading">
    <p class="map-label">
      FLIGHT TELEMETRY / DEMONSTRATION
    </p>

    <h2>{title}</h2>

    <p>
      Interactive reconstruction using fictional GPS
      coordinates. Select a waypoint to inspect its data.
      Timeline event selections can also focus a waypoint.
    </p>
  </div>

  <div
    id="drone-flight-map"
    class="drone-flight-map"
    role="region"
    aria-label="Simulated drone flight route"
  ></div>

  <p class="map-note">
    Demonstration data only. Not actual forensic evidence.
    Coordinates and flight measurements are synthetic.
  </p>
</section>

<style>
  .drone-map-section {
    margin: 55px 0;
    padding: 25px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .map-label {
    color: var(--accent);
    font-family: Consolas, monospace;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .map-heading h2 {
    margin: 10px 0;
  }

  .map-heading p,
  .map-note {
    color: var(--muted);
    line-height: 1.6;
  }

  .drone-flight-map {
    height: 420px;
    width: 100%;
    margin-top: 25px;
    border: 1px solid var(--border);
    border-radius: 10px;
    z-index: 0;
  }

  .map-note {
    margin: 15px 0 0;
    font-size: 0.8rem;
  }

  @media (max-width: 600px) {
    .drone-map-section {
      padding: 15px;
    }

    .drone-flight-map {
      height: 320px;
    }
  }
</style>

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";

  import { demoFlight } from "../data/demoFlight";

  interface WaypointSelection {
    eventId: string;
    waypointId: string;
    time: number;
  }

  function initialiseDroneFlightMap() {
    const mapElement = document.getElementById(
      "drone-flight-map"
    );

    if (!mapElement) return;

    // Prevent duplicate Leaflet initialisation.
    if (mapElement.dataset.mapReady === "true") return;

    if (demoFlight.length === 0) return;

    const map = L.map(mapElement, {
      scrollWheelZoom: false
    });

    mapElement.dataset.mapReady = "true";

    L.tileLayer(
      "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
      {
        attribution:
          '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19
      }
    ).addTo(map);

    // All waypoints use the shared synthetic dataset.
    const coordinates: L.LatLngTuple[] = demoFlight.map(
      (point) => [
        point.latitude,
        point.longitude
      ]
    );

    const route = L.polyline(coordinates, {
      color: "#52c7ea",
      weight: 4
    }).addTo(map);

    // Keep references to markers so timeline events
    // can focus the corresponding waypoint.
    const waypointMarkers = new Map<
      string,
      L.CircleMarker
    >();

    demoFlight.forEach((point, index) => {
      const isStart = index === 0;
      const isEnd = index === demoFlight.length - 1;

      const colour = isStart
        ? "#86c7aa"
        : isEnd
          ? "#e5b96c"
          : "#52c7ea";

      const waypointLabel = isStart
        ? "Take-off"
        : isEnd
          ? "Landing"
          : "Waypoint";

      const marker = L.circleMarker(
        [point.latitude, point.longitude],
        {
          radius: isStart || isEnd ? 8 : 5,
          color: colour,
          fillColor: colour,
          fillOpacity: 0.9
        }
      )
        .addTo(map)
        .bindPopup(`
          <strong>${waypointLabel} — ${point.id}</strong>
          <p>Elapsed time: ${point.time} seconds</p>
          <p>Altitude: ${point.altitude} (demo units)</p>
          <p>Latitude: ${point.latitude.toFixed(5)}</p>
          <p>Longitude: ${point.longitude.toFixed(5)}</p>
          <p>Synthetic demonstration record</p>
        `);

      waypointMarkers.set(point.id, marker);
    });

    map.fitBounds(route.getBounds(), {
      padding: [30, 30]
    });

    const workspace = mapElement.closest(
      "[data-investigation-workspace]"
    );

    let selectedWaypointId: string | null = null;
    let highlightedMarker: L.CircleMarker | null = null;

    // Remember original marker styles so a previous
    // selection can be restored.
    
const originalStyles = new Map<
  string,
  L.CircleMarkerOptions
>();


    demoFlight.forEach((point, index) => {
      const isStart = index === 0;
      const isEnd = index === demoFlight.length - 1;

      const colour = isStart
        ? "#86c7aa"
        : isEnd
          ? "#e5b96c"
          : "#52c7ea";

      originalStyles.set(point.id, {
        radius: isStart || isEnd ? 8 : 5,
        color: colour,
        fillColor: colour,
        fillOpacity: 0.9,
        weight: 3
      });
    });

    function focusWaypoint(waypointId: string) {
      const marker = waypointMarkers.get(waypointId);

      if (!marker) return;

      if (highlightedMarker) {
        const previousId = Array.from(
          waypointMarkers.entries()
        ).find(
          ([, candidate]) => candidate === highlightedMarker
        )?.[0];

        if (previousId) {
          const originalStyle = originalStyles.get(previousId);

          if (originalStyle) {
            highlightedMarker.setStyle(originalStyle);
            highlightedMarker.setRadius(
              originalStyle.radius ?? 5
            );
          }
        }
      }

      marker.setStyle({
        color: "#ffffff",
        fillColor: "#52c7ea",
        fillOpacity: 1,
        weight: 4
      });

      marker.setRadius(10);
      marker.bringToFront();

      highlightedMarker = marker;

      map.panTo(marker.getLatLng());
      marker.openPopup();
    }

    // A selection may occur while the map is hidden.
    // Store it until the map panel becomes visible.
    const handleWaypointSelection = (event: Event) => {
      const selection = (
        event as CustomEvent<WaypointSelection>
      ).detail;

      if (!selection?.waypointId) return;

      if (!waypointMarkers.has(selection.waypointId)) {
        return;
      }

      selectedWaypointId = selection.waypointId;

      if (mapElement.getClientRects().length > 0) {
        requestAnimationFrame(() => {
          focusWaypoint(selection.waypointId);
        });
      }
    };

    const refreshMap = () => {
      if (mapElement.getClientRects().length === 0) {
        return;
      }

      requestAnimationFrame(() => {
        map.invalidateSize();

        if (selectedWaypointId) {
          focusWaypoint(selectedWaypointId);
        } else {
          map.fitBounds(route.getBounds(), {
            padding: [30, 30]
          });
        }
      });
    };

    // Listen on the document because the timeline and
    // map are separate components within the workspace.
    document.addEventListener(
      "tt:waypoint-select",
      handleWaypointSelection
    );

    workspace?.addEventListener(
      "tt:map-visible",
      refreshMap
    );

    window.addEventListener("resize", refreshMap);
  }

  initialiseDroneFlightMap();

  document.addEventListener(
    "astro:page-load",
    initialiseDroneFlightMap
  );
</script>
