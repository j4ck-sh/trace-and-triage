---

import DroneFlightMap from "./DroneFlightMap.astro";

import ForensicAnalyticsWorkspace from "./ForensicAnalyticsWorkspace.astro";

import InteractiveEventTimeline from "./InteractiveEventTimeline.astro";

import EvidenceRelationshipGraph from "./EvidenceRelationshipGraph.astro";
import DroneInvestigationReport from "./DroneInvestigationReport.astro";

import DatasetStatusBar from "./DatasetStatusBar.astro";

import DatasetInformation from "./DatasetInformation.astro";

import { droneDataset } from "../data/droneDataset";

import { demoEvents } from "../data/demoEvents";

import {

  demoEvidenceNodes,

  demoEvidenceLinks

} from "../data/demoEvidence";

const tabs = [

  { id: "overview", label: "Overview", number: "00" },

  { id: "map", label: "Flight Map", number: "01" },

  { id: "telemetry", label: "Telemetry", number: "02" },

  { id: "events", label: "Events", number: "03" },

  { id: "evidence", label: "Evidence", number: "04" },

  { id: "report", label: "Report", number: "05" }

];

const workspaceId = "tt-drone-workspace";

---

<section

  class="investigation-workspace"

  data-investigation-workspace

  aria-label="Drone Forensics investigation workspace"

>

  <div class="workspace-header">

    <div>

      <p class="workspace-eyebrow">

        TT / INTERACTIVE LABORATORY

      </p>

      <h2>Investigation Console</h2>

      <p class="workspace-description">

        Explore flight reconstruction, telemetry,

        event chronology and evidence relationships

        through a unified technical workspace.

      </p>

    </div>

    <span class="workspace-status">

      DEMONSTRATION ANALYTICS

    </span>

  </div>

  <DatasetStatusBar dataset={droneDataset} />
  <!-- TABS -->
  <p id="tt-workspace-help" class="workspace-help">

  Use the arrow keys to switch investigation views.

  Press Tab to enter the selected panel.

  </p>

  <div

    class="workspace-tabs"

    role="tablist"

    aria-label="Investigation tools"

    aria-describedby="tt-workspace-help"

  >

    {tabs.map((tab, index) => (

      <button

        type="button"

        id={`${workspaceId}-tab-${tab.id}`}

        class="workspace-tab"

        role="tab"

        aria-selected={index === 0 ? "true" : "false"}

        aria-controls={`${workspaceId}-panel-${tab.id}`}

        tabindex={index === 0 ? 0 : -1}

        data-workspace-tab={tab.id}

      >

        <span class="tab-number">{tab.number}</span>

        <span>{tab.label}</span>

      </button>

    ))}

  </div>
  <!-- OVERVIEW -->
  <section

    id={`${workspaceId}-panel-overview`}

    class="workspace-panel"

    role="tabpanel"

    aria-labelledby={`${workspaceId}-tab-overview`}

    data-workspace-panel="overview"

    tabindex="0"

  >

    <div class="overview-grid">

      <div class="overview-intro">

        <p class="panel-label">00 / WORKSPACE OVERVIEW</p>

        <h3>Drone Forensics Laboratory</h3>

        <p>

          This workspace provides a structured interface

          for examining drone flight reconstruction,

          telemetry and evidence relationships.

        </p>

        <p>

          Select a tab above to explore each analytical

          tool individually.

        </p>

      </div>

      <div class="dataset-notice">

        <strong>Demonstration environment</strong>

          <p>

    The telemetry, event timeline and evidence

    relationships use synthetic demonstration data.

    These visualisations are not derived from

    a verified forensic evidence collection.

          </p>

      </div>

<div class="workspace-data-notice">

  <strong>Data integrity notice</strong>

  <p>

    The flight map, telemetry and event timeline use

    a shared synthetic demonstration dataset.

    Flight coordinates, altitude measurements and

    event-to-waypoint references are fictional and

    provided for interactive investigation training.

    The evidence relationship visualisation illustrates

    connections between synthetic records. It does not

    represent independently acquired or verified evidence.

    No forensic conclusions about an actual aircraft,

    flight or incident should be drawn from these

    demonstration visualisations.

  </p>

</div>

      <div class="overview-details">

        <div>

          <span>FLIGHT MAP</span>

          <strong>Interactive Leaflet mapping</strong>

        </div>

        <div>

          <span>TELEMETRY</span>

          <strong>Synthetic demonstration data</strong>

        </div>

        <div>

          <span>EVENTS</span>

          <strong>Interactive event chronology</strong>

        </div>

        <div>

          <span>EVIDENCE</span>

          <strong>Artefact relationship analysis</strong>

        </div>

      </div>

    </div>

  </section>
  <!-- FLIGHT MAP -->
  <section

    id={`${workspaceId}-panel-map`}

    class="workspace-panel"

    role="tabpanel"

    aria-labelledby={`${workspaceId}-tab-map`}

    data-workspace-panel="map"

    tabindex="0"

    hidden

  >

    <div class="panel-heading">

      <p class="panel-label">01 / FLIGHT RECONSTRUCTION</p>

      <h3>Drone Flight Map</h3>

      <p>

        Interactive geospatial flight reconstruction.

      </p>

    </div>

    <div class="workspace-map">

      <DroneFlightMap />

    </div>

  </section>
  <!-- TELEMETRY -->
  <section

    id={`${workspaceId}-panel-telemetry`}

    class="workspace-panel"

    role="tabpanel"

    aria-labelledby={`${workspaceId}-tab-telemetry`}

    data-workspace-panel="telemetry"

    tabindex="0"

    hidden

  >

    <ForensicAnalyticsWorkspace />

  </section>
  <!-- EVENTS -->
  <section

    id={`${workspaceId}-panel-events`}

    class="workspace-panel"

    role="tabpanel"

    aria-labelledby={`${workspaceId}-tab-events`}

    data-workspace-panel="events"

    tabindex="0"

    hidden

  >

    <InteractiveEventTimeline

      events={demoEvents}

      title="Flight Event Timeline"

    />

  </section>
  <!-- EVIDENCE -->
  <section

    id={`${workspaceId}-panel-evidence`}

    class="workspace-panel"

    role="tabpanel"

    aria-labelledby={`${workspaceId}-tab-evidence`}

    data-workspace-panel="evidence"

    tabindex="0"

    hidden

  >

    <EvidenceRelationshipGraph

      nodes={demoEvidenceNodes}

      links={demoEvidenceLinks}

      title="Drone Evidence Relationships"

    />

  </section>
  <!-- REPORT -->

  <section
    id={`${workspaceId}-panel-report`}
    class="workspace-panel"
    role="tabpanel"
    aria-labelledby={`${workspaceId}-tab-report`}
    data-workspace-panel="report"
    tabindex="0"
    hidden
  >
    <DroneInvestigationReport />

    <div class="report-intro">
      <p class="panel-label">05 / SUPPORTING RESEARCH</p>
      <h3>Project Documentation</h3>

      <p>
        The report above summarises the synthetic
        demonstration dataset. The supporting project
        documentation provides additional research
        context, methodology and technical discussion
        where documented.
      </p>

      <p>
        Research documentation should not be interpreted
        as verification of the fictional flight records
        presented in this laboratory.
      </p>

      <a href="#tt-project-documentation">
        Jump to Project Documentation
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <DatasetInformation dataset={droneDataset} />

  <div class="workspace-footer">

    <span>TRACE & TRIAGE / DRONE LAB</span>

    <span>ANALYTICS DATA / SYNTHETIC</span>

  </div>

</section>

<style>

  .investigation-workspace {

    min-width: 0;

    margin: 45px 0;

    padding: 25px;

    background: var(--tt-deep);

    border: 1px solid var(--tt-border);

    border-radius: var(--tt-radius-md);

  }

  .workspace-header {

    display: flex;

    justify-content: space-between;

    align-items: flex-start;

    flex-wrap: wrap;

    gap: 20px;

    margin-bottom: 30px;

  }

  .workspace-eyebrow,

  .panel-label {

    color: var(--tt-purple);

    font-family: var(--tt-font-mono);

    font-size: 0.75rem;

    letter-spacing: 0.08em;

  }

  .workspace-header h2 {

    margin: 12px 0;

    color: var(--tt-heading);

    font-family: var(--tt-font-editorial);

    font-size: clamp(2rem, 4vw, 3.2rem);

    font-weight: 400;

  }

  .workspace-description {

    max-width: 720px;

    color: var(--tt-muted);

    line-height: 1.8;

  }

  .workspace-status {

    padding: 8px 11px;

    border: 1px solid var(--tt-orange);

    border-radius: 4px;

    color: var(--tt-orange);

    font-family: var(--tt-font-mono);

    font-size: 0.7rem;

  }

/* TAB NAVIGATION */

  .workspace-tabs {

    display: flex;

    flex-wrap: wrap;

    gap: 8px;

    padding-bottom: 18px;

    border-bottom: 1px solid var(--tt-border);

  }

  .workspace-tab {

    display: inline-flex;

    align-items: center;

    gap: 8px;

    padding: 12px 15px;

    background: var(--tt-surface);

    border: 1px solid var(--tt-border);

    border-radius: 4px;

    color: var(--tt-muted);

    font-family: var(--tt-font-mono);

    font-size: 0.8rem;

    cursor: pointer;

  }

  .workspace-tab:hover {

    border-color: var(--tt-blue);

    color: var(--tt-heading);

  }

  .workspace-tab[aria-selected="true"] {

    background: var(--tt-raised);

    border-color: var(--tt-blue);

    color: var(--tt-blue);

  }

  .workspace-tab:focus-visible {

    outline: 2px solid var(--tt-blue);

    outline-offset: 3px;

  }

  .tab-number {

    color: var(--tt-purple);

    font-size: 0.7rem;

  }

/* TAB PANELS */

  .workspace-panel {

    min-width: 0;

    padding: 25px 0;

  }

  .workspace-panel[hidden] {

    display: none !important;

  }

  .panel-heading {

    margin-bottom: 25px;

  }

  .panel-heading h3,

  .overview-intro h3,

  .report-intro h3 {

    margin: 12px 0;

    color: var(--tt-heading);

    font-family: var(--tt-font-editorial);

    font-size: clamp(1.7rem, 3vw, 2.5rem);

    font-weight: 400;

  }

  .panel-heading p,

  .overview-intro p,

  .report-intro p {

    color: var(--tt-muted);

    line-height: 1.8;

  }

/* OVERVIEW */

  .overview-grid {

    display: grid;

    grid-template-columns: minmax(0, 1.2fr) minmax(250px, 0.8fr);

    gap: 25px;

  }

  .overview-details {

    display: grid;

    gap: 10px;

  }

  .overview-details > div {

    display: flex;

    flex-direction: column;

    gap: 8px;

    padding: 15px;

    background: var(--tt-surface);

    border: 1px solid var(--tt-border);

    border-radius: 4px;

  }

  .overview-details span {

    color: var(--tt-purple);

    font-family: var(--tt-font-mono);

    font-size: 0.7rem;

  }

  .overview-details strong {

    color: var(--tt-heading);

    font-size: 0.9rem;

  }

/* MAP */

  .workspace-map {

    position: relative;

    min-width: 0;

    min-height: 440px;

    overflow: hidden;

    background: var(--tt-surface);

    border: 1px solid var(--tt-border);

    border-radius: 5px;

  }

  .workspace-map :global(.leaflet-container) {

    width: 100%;

    min-height: 440px;

    z-index: 0;

  }

/* REPORT */

  .report-intro {

    max-width: 750px;

  }

  .report-intro a {

    display: inline-flex;

    gap: 12px;

    margin-top: 15px;

    color: var(--tt-blue);

    font-family: var(--tt-font-mono);

    text-decoration: none;

  }

  .report-intro a:hover {

    text-decoration: underline;

  }

/* FOOTER */

  .workspace-footer {

    display: flex;

    justify-content: space-between;

    flex-wrap: wrap;

    gap: 12px;

    padding-top: 18px;

    border-top: 1px solid var(--tt-border);

    color: var(--tt-muted);

    font-family: var(--tt-font-mono);

    font-size: 0.7rem;

  }

/* RESPONSIVE */

  @media (max-width: 850px) {

    .overview-grid {

      grid-template-columns: 1fr;

    }

  }

  @media (max-width: 650px) {

    .investigation-workspace {

      padding: 15px;

    }

    .workspace-tab {

      padding: 10px;

      font-size: 0.75rem;

    }

    .workspace-map,

    .workspace-map :global(.leaflet-container) {

      min-height: 350px;

    }

  }

  @media (prefers-reduced-motion: reduce) {

    .workspace-tab {

      transition: none;

    }

  }

/* STAGE 68.7 — DATASET NOTICE */

.dataset-notice {

  margin-top: 25px;

  padding: 18px;

  background: var(--tt-surface);

  border: 1px solid var(--tt-orange);

  border-left: 3px solid var(--tt-orange);

  border-radius: var(--tt-radius-md);

}

.dataset-notice strong {

  color: var(--tt-orange);

  font-family: var(--tt-font-mono);

  font-size: 0.8rem;

}

.dataset-notice p {

  margin: 10px 0 0;

  color: var(--tt-muted);

  line-height: 1.75;

}

.workspace-help {

  margin: 12px 0;

  color: var(--tt-muted);

  font-family: var(--tt-font-mono);

  font-size: 0.75rem;

  line-height: 1.6;

}

.workspace-data-notice {

  margin-top: 25px;

  padding: 18px;

  background: var(--tt-surface);

  border: 1px solid var(--tt-orange);

  border-left: 3px solid var(--tt-orange);

  border-radius: var(--tt-radius-md);

}

.workspace-data-notice strong {

  color: var(--tt-orange);

  font-family: var(--tt-font-mono);

  font-size: 0.8rem;

}

.workspace-data-notice p {

  margin: 12px 0 0;

  color: var(--tt-muted);

  line-height: 1.75;

}

</style>

<script>

  function initialiseWorkspaces() {

    document.querySelectorAll<HTMLElement>(

      "[data-investigation-workspace]"

    ).forEach((root) => {

      if (root.dataset.ready === "true") return;

      const tabs = Array.from(

        root.querySelectorAll<HTMLButtonElement>(

          "[data-workspace-tab]"

        )

      );

      const panels = Array.from(

        root.querySelectorAll<HTMLElement>(

          "[data-workspace-panel]"

        )

      );

      if (!tabs.length || !panels.length) return;

      function activateTab(index: number, focus = false) {

        const selected = tabs[index];

        if (!selected) return;

        const selectedId = selected.dataset.workspaceTab;

        tabs.forEach((tab, tabIndex) => {

          const active = tabIndex === index;

          tab.setAttribute(

            "aria-selected",

            String(active)

          );

          tab.tabIndex = active ? 0 : -1;

        });

        panels.forEach((panel) => {

          panel.hidden =

            panel.dataset.workspacePanel !== selectedId;

        });

        if (focus) selected.focus();
  // Notify embedded components when the visible  // workspace changes.
        root.dispatchEvent(

          new CustomEvent("tt:workspace-change", {

            bubbles: true,

            detail: { tab: selectedId }

          })

        );
  // Leaflet maps require a size refresh after  // their hidden container becomes visible.
        if (selectedId === "map") {

  requestAnimationFrame(() => {

    requestAnimationFrame(() => {

      window.dispatchEvent(new Event("resize"));

      root.dispatchEvent(

        new CustomEvent("tt:map-visible", {

          bubbles: true

        })

      );

    });

  });

}

      }
  // Allow investigation components to request a tab.  // Reuse the existing accessible tab controller.
    root.addEventListener("tt:workspace-navigate", (event) => {

      const navigation = (

        event as CustomEvent<{ tab: string }>

      ).detail;

      if (!navigation?.tab) return;

      const targetIndex = tabs.findIndex(

        (tab) => tab.dataset.workspaceTab === navigation.tab

      );

      if (targetIndex === -1) return;

      activateTab(targetIndex, true);

    });

      tabs.forEach((tab, index) => {

        tab.addEventListener("click", () => {

          activateTab(index);

        });

        tab.addEventListener("keydown", (event) => {

  let next = index;

  if (

    event.key === "ArrowRight" ||

    event.key === "ArrowDown"

  ) {

    next = (index + 1) % tabs.length;

  } else if (

    event.key === "ArrowLeft" ||

    event.key === "ArrowUp"

  ) {

    next = (index - 1 + tabs.length) % tabs.length;

  } else if (event.key === "Home") {

    next = 0;

  } else if (event.key === "End") {

    next = tabs.length - 1;

  } else {

    return;

  }

  event.preventDefault();

  activateTab(next, true);

  tabs[next]?.scrollIntoView({

    behavior: "auto",

    block: "nearest",

    inline: "nearest"

  });

});

      });

      root.dataset.ready = "true";

      activateTab(0);

    });

  }

  initialiseWorkspaces();

  document.addEventListener(

    "astro:page-load",

    initialiseWorkspaces

  );

</script>