
---
import { social } from "../config/social";

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();

const footerNavigation = [
  { label: "Home", href: base },
  { label: "Research", href: `${base}research/` },
  { label: "Projects", href: `${base}projects/` },
  { label: "About", href: `${base}about/` }
];
---

<footer class="tt-footer">
  <div class="footer-inner">

    <div class="footer-main">
      <div class="footer-brand">
        <a href={base} class="footer-wordmark">
          <span class="brand-symbol" aria-hidden="true">
            ◈
          </span>
          <span>TRACE <span class="brand-accent">&</span> TRIAGE</span>
        </a>

        <p class="footer-tagline">
          Digital Forensics / Incident Response / Security Research
        </p>

        <p class="footer-description">
          Independent technical investigations, evidence-led
          research and interactive security laboratories.
        </p>
      </div>

      <div class="footer-navigation">
        <h2>Explore</h2>

        <ul>
          {footerNavigation.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-social">
        <h2>Connect</h2>

        <ul>
          <li>
            <a
              href={social.github}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub
              <span aria-hidden="true">↗</span>
            </a>
          </li>

          <li>
            <a
              href={social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn
              <span aria-hidden="true">↗</span>
            </a>
          </li>

          <li>
            <a href={`${base}rss.xml`}>
              RSS Feed
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-disclaimer">
      <span class="disclaimer-label">Research notice</span>

      <p>
        Research and opinions published here are my own and do
        not represent my employer. All security testing is
        performed in isolated or authorised environments.
      </p>
    </div>

    <div class="footer-bottom">
      <p>
        © {year} Trace & Triage. All rights reserved.
      </p>

      <p class="footer-technology">
        Built with Astro
        <span aria-hidden="true">·</span>
        Hosted on GitHub Pages
      </p>
    </div>

  </div>
</footer>

<style>
  .tt-footer {
    margin-top: 80px;
    border-top: 1px solid var(--tt-border);
    background: var(--tt-deep);
    color: var(--tt-text);
  }

  .footer-inner {
    width: min(100% - 40px, 1250px);
    margin: 0 auto;
    padding: 56px 0 24px;
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(0, 2fr) 1fr 1fr;
    gap: 48px;
    padding-bottom: 40px;
  }

  .footer-brand {
    max-width: 520px;
  }

  .footer-wordmark {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--tt-heading);
    font-family: var(--tt-font-mono);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .brand-symbol {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--tt-blue);
    border-radius: 6px;
    background: var(--tt-surface);
    color: var(--tt-blue);
    font-size: 1.4rem;
  }

  .brand-accent {
    color: var(--tt-blue);
  }

  .footer-tagline {
    margin: 18px 0 12px;
    color: var(--tt-blue);
    font-family: var(--tt-font-mono);
    font-size: 0.72rem;
    line-height: 1.8;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .footer-description {
    max-width: 460px;
    margin: 0;
    color: var(--tt-muted);
    font-size: 0.92rem;
    line-height: 1.8;
  }

  .footer-navigation h2,
  .footer-social h2 {
    margin: 0 0 20px;
    color: var(--tt-heading);
    font-family: var(--tt-font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-navigation ul,
  .footer-social ul {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-navigation a,
  .footer-social a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--tt-muted);
    font-family: var(--tt-font-mono);
    font-size: 0.8rem;
    text-decoration: none;
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .footer-navigation a:hover,
  .footer-social a:hover {
    color: var(--tt-blue);
    transform: translateX(3px);
  }

  .footer-wordmark:focus-visible,
  .footer-navigation a:focus-visible,
  .footer-social a:focus-visible {
    outline: 2px solid var(--tt-blue);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .footer-disclaimer {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 24px;
    padding: 24px 0;
    border-top: 1px solid var(--tt-border);
    border-bottom: 1px solid var(--tt-border);
  }

  .disclaimer-label {
    color: var(--tt-blue);
    font-family: var(--tt-font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .footer-disclaimer p {
    max-width: 850px;
    margin: 0;
    color: var(--tt-muted);
    font-size: 0.8rem;
    line-height: 1.8;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
    padding-top: 24px;
  }

  .footer-bottom p {
    margin: 0;
    color: var(--tt-muted);
    font-family: var(--tt-font-mono);
    font-size: 0.72rem;
  }

  .footer-technology {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  @media (max-width: 800px) {
    .footer-main {
      grid-template-columns: minmax(0, 1fr) 1fr;
      gap: 36px;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 500px) {
    .footer-inner {
      width: min(100% - 30px, 1250px);
      padding-top: 40px;
    }

    .footer-main {
      grid-template-columns: 1fr 1fr;
      gap: 32px 20px;
    }

    .footer-disclaimer {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-wordmark {
      font-size: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-navigation a,
    .footer-social a {
      transition: none;
    }

    .footer-navigation a:hover,
    .footer-social a:hover {
      transform: none;
    }
  }

  :global(html.tt-motion-paused) .footer-navigation a,
  :global(html.tt-motion-paused) .footer-social a {
    transition: none;
  }

  :global(html.tt-motion-paused) .footer-navigation a:hover,
  :global(html.tt-motion-paused) .footer-social a:hover {
    transform: none;
  }
</style>
