---
import { social } from "../config/social";
---

<footer>
  <div class="footer-content">

    <div>
      <strong>TRACE & TRIAGE</strong>

      <p>
        Digital Forensics • Incident Response • Security Research
      </p>
    </div>

    <p class="disclaimer">
      Research and opinions published here are my own and do not
      represent my employer. All security testing is performed
      in isolated or authorised environments.
    </p>
    
    
  <div class="social-links">
    <a
      href={social.github}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Trace and Triage GitHub profile"
    >
      GitHub ↗
    </a>

    <a
      href={social.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="LinkedIn profile"
    >
      LinkedIn ↗
    </a>

    <a
      href={`${import.meta.env.BASE_URL}rss.xml`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Subscribe to Trace and Triage RSS feed"
    >
    RSS Feed
    </a>
  </div>


  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    margin-top: 80px;
  }

  .footer-content {
    max-width: var(--max-width);
    margin: auto;

    padding: 40px 30px;

    color: var(--muted);
  }

  strong {
    color: var(--text);
    font-family: Consolas, monospace;
  }

  .disclaimer {
    font-size: 0.85rem;
    max-width: 750px;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 15px;
  }

  .social-links a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .social-links a:hover {
    color: var(--accent);
  }

  .social-links a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>