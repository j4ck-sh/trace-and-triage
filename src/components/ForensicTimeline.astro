
---
export interface TimelineEvent {
  timestamp: string;
  title: string;
  description?: string;
  source?: string;
}

interface Props {
  events: TimelineEvent[];
  heading?: string;
}

const {
  events,
  heading = "Investigation Timeline"
} = Astro.props;
---

<section class="forensic-timeline">
  <h2>{heading}</h2>

  <ol class="timeline-list">
    {events.map((event) => (
      <li class="timeline-event">
        <div class="timeline-marker"></div>

        <div class="timeline-content">
          <time>{event.timestamp}</time>
          <h3>{event.title}</h3>

          {event.description && (
            <p>{event.description}</p>
          )}

          {event.source && (
            <span class="timeline-source">
              SOURCE: {event.source}
            </span>
          )}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .forensic-timeline {
    margin: 45px 0;
  }

  .forensic-timeline h2 {
    color: var(--text);
    margin-bottom: 30px;
  }

  .timeline-list {
    list-style: none;
    padding: 0 0 0 22px;
    margin: 0;
    border-left: 2px solid var(--border);
  }

  .timeline-event {
    position: relative;
    padding: 0 0 30px 25px;
  }

  .timeline-marker {
    position: absolute;
    left: -29px;
    top: 6px;
    width: 12px;
    height: 12px;
    background: var(--accent);
    border: 3px solid var(--background);
    border-radius: 50%;
  }

  .timeline-content {
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  time {
    color: var(--accent);
    font-family: Consolas, monospace;
    font-size: 0.85rem;
  }

  .timeline-content h3 {
    margin: 10px 0;
    font-size: 1.1rem;
  }

  .timeline-content p {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 12px;
  }

  .timeline-source {
    color: var(--muted);
    font-family: Consolas, monospace;
    font-size: 0.75rem;
  }
</style>