---
interface Props {
  title: string;
  description: string;
  caseId?: string;
  category?: string;
  date?: Date;
  readingTime?: string;
  difficulty?: string;
  status?: string;
  tags?: string[];
}
const { title, description, caseId, category, date, readingTime, difficulty, status, tags = [] } = Astro.props;
---
<header class="tt-article-hero">
  <div class="hero-top"><span>TT / INVESTIGATION JOURNAL</span><span>{caseId ?? 'RESEARCH'}</span></div>
  {category && <p class="hero-category">{category}</p>}
  <h1>{title}</h1>
  <p class="hero-description">{description}</p>
  <div class="hero-metadata">
    {date && <time datetime={date.toISOString()}>{date.toLocaleDateString('en-GB', { day:'numeric', month:'long', year:'numeric' })}</time>}
    {readingTime && <span>{readingTime}</span>}
    {difficulty && <span>{difficulty}</span>}
    {status && <span class="hero-status">{status}</span>}
  </div>
  {tags.length > 0 && <div class="hero-tags">{tags.map(tag => <span>{tag}</span>)}</div>}
</header>
<style>
.tt-article-hero { padding: 35px 0 40px; border-top: 1px solid var(--tt-border); border-bottom: 1px solid var(--tt-border); }
.hero-top, .hero-metadata { display:flex; flex-wrap:wrap; justify-content:space-between; gap:14px; font: .75rem var(--tt-font-mono); color:var(--tt-muted); }
.hero-top span:first-child, .hero-category { color:var(--tt-blue); }
.hero-category { margin:55px 0 0; font:.8rem var(--tt-font-mono); text-transform:uppercase; letter-spacing:.08em; }
h1 { max-width:1000px; margin:18px 0 22px; font:400 clamp(2.8rem,6vw,5.8rem)/1.08 var(--tt-font-editorial); letter-spacing:-.045em; color:var(--tt-heading); }
.hero-description { max-width:790px; color:var(--tt-muted); font-size:1.12rem; line-height:1.8; }
.hero-metadata { justify-content:flex-start; margin-top:35px; padding-top:18px; border-top:1px solid var(--tt-border); }
.hero-status { color:var(--tt-green); }
.hero-tags { display:flex; flex-wrap:wrap; gap:8px; margin-top:20px; }
.hero-tags span { border:1px solid var(--tt-border); border-radius:4px; padding:5px 9px; font:.75rem var(--tt-font-mono); color:var(--tt-muted); }
@media(max-width:650px) { .hero-category { margin-top:35px; } }
</style>