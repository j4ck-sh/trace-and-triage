
---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CommandPalette from "../components/CommandPalette.astro";

import "../styles/global.css";
import "../styles/brand.css";
import "../styles/themes.css";
import "../styles/theme-motion.css";
import "../styles/motion.css";
import "../styles/article-design.css";
import "../styles/forensic-visualisations.css";
import "../styles/forensic-accessibility.css";
import "../styles/navigation.css";
import "../styles/navigation-microinteractions.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedDate?: Date;
}

const {
  title = "Trace & Triage",
  description =
    "Digital Forensics, Incident Response and Security Research",
  image: suppliedImage,
  type = "website",
  publishedDate
} = Astro.props;

// GitHub Pages base path
const base = import.meta.env.BASE_URL;

// Use supplied social image or the default
const image = suppliedImage || "/images/default-social.png";

// Convert image paths into absolute URLs
function getAbsoluteImageURL(imagePath: string): string {
  // Already an absolute URL
  if (/^https?:\/\//i.test(imagePath)) {
    return imagePath;
  }

  // Remove leading slashes
  let cleanPath = imagePath.replace(/^\/+/, "");

  // Avoid duplicating the repository base path
  const cleanBase = base.replace(/^\/+|\/+$/g, "");

  if (
    cleanBase &&
    cleanPath.startsWith(`${cleanBase}/`)
  ) {
    cleanPath = cleanPath.slice(cleanBase.length + 1);
  }

  // Build the final URL
  return new URL(
    `${base}${cleanPath}`,
    Astro.site ?? Astro.url
  ).toString();
}

// Canonical URL for this page
const canonicalURL = Astro.url.toString();

// Absolute social preview image URL
const socialImageURL = getAbsoluteImageURL(image);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <!-- Initialise theme and motion preferences early -->
    <script is:inline>
      try {
        const allowedThemes = [
          "tokyo-night",
          "gruvbox",
          "nord"
        ];

        const savedTheme = localStorage.getItem("tt-theme");

        document.documentElement.dataset.theme =
          allowedThemes.includes(savedTheme)
            ? savedTheme
            : "tokyo-night";
      } catch {
        document.documentElement.dataset.theme = "tokyo-night";
      }

      try {
        const savedMotion = localStorage.getItem(
          "tt-motion-paused"
        );

        if (savedMotion === "true") {
          document.documentElement.classList.add(
            "tt-motion-paused"
          );
        }
      } catch {
        // Storage may be unavailable.
        // The site remains usable without saved preferences.
      }
    </script>

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <!-- SVG favicon -->
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${base}favicon.svg`}
    />

    <!-- Page metadata -->
    <meta
      name="description"
      content={description}
    />

    <title>{title}</title>

    <!-- Canonical URL -->
    <link
      rel="canonical"
      href={canonicalURL}
    />

    <!-- Open Graph / LinkedIn -->
    <meta property="og:type" content={type} />
    <meta
      property="og:site_name"
      content="Trace & Triage"
    />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content={description}
    />
    <meta
      property="og:url"
      content={canonicalURL}
    />
    <meta
      property="og:image"
      content={socialImageURL}
    />
    <meta
      property="og:image:alt"
      content="Trace & Triage research preview"
    />

    <!-- Twitter / X -->
    <meta
      name="twitter:card"
      content="summary_large_image"
    />
    <meta
      name="twitter:title"
      content={title}
    />
    <meta
      name="twitter:description"
      content={description}
    />
    <meta
      name="twitter:image"
      content={socialImageURL}
    />

    <!-- Article publication date -->
    {type === "article" && publishedDate && (
      <meta
        property="article:published_time"
        content={publishedDate.toISOString()}
      />
    )}

    <!-- Research RSS feed -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Trace & Triage Research RSS Feed"
      href={`${base}rss.xml`}
    />
  </head>

  <body>
    <Header />
    <CommandPalette />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
