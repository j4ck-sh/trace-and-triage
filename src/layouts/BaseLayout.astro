---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Trace & Triage",
  description = "Digital Forensics, Incident Response and Security Research"
} = Astro.props;
---

<!doctype html>
<html lang="en" data-base={import.meta.env.BASE_URL}>

  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content={description}
    />

    <title>{title}</title>
  </head>

  <body>

    <Header />

    <main>
      <slot />
    </main>

    <Footer />

  </body>

</html>